- id: '1733041026132'
  alias: Ververs Greenwave PowerNode Sockets
  description: Ververs elke 5 minuten de energiewaarden van de Greenwave PowerNode stekkers via Z-Wave
  triggers:
  - trigger: time_pattern
    minutes: /5
  conditions: []
  actions:
  - action: zwave_js.refresh_value
    metadata: {}
    data:
      entity_id:
      - sensor.stroomblok_electric_consumption_kwh_6
      - sensor.stroomblok_electric_consumption_kwh_5
  mode: single
- id: '1734326332877'
  alias: Automatische Backups
  description: Maakt dagelijks automatische backups van Home Assistant configuratie en data volgens een
    vast schema
  use_blueprint:
    path: jcwillox/automatic_backups.yaml
- id: '1742276544597'
  alias: Ochtend Keuken Routine
  description: Start de ochtendrutine bij aanwezigheid in de keuken tussen 05:30 en 09:30. Schakelt keukenverlichting
    geleidelijk in, zet het koffiezetapparaat aan indien remote start actief is, en speelt Radio Veronica
    af
  triggers:
  - trigger: state
    entity_id:
    - binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3
    to: 'on'
    from: 'off'
  conditions:
  - condition: time
    weekday:
    - mon
    - tue
    - wed
    - thu
    - fri
    - sat
    - sun
    enabled: true
    after: 05:30:00
    before: 09:30:00
  - condition: template
    value_template: '{% set lt = state_attr(''automation.ochtend_keuken_routine'', ''last_triggered'')
      %}

      {{ lt is none or (as_timestamp(now()) - as_timestamp(lt)) > 14400 }}'
  actions:
  - parallel:
    - choose:
      - conditions:
        - condition: state
          entity_id: binary_sensor.espresso_volautomaat_start_op_afstand
          state: 'on'
        sequence:
        - action: switch.turn_on
          data: {}
          target:
            entity_id: switch.espresso_volautomaat_inschakelen
      alias: Start Coffee Machine
    - sequence:
      - action: media_player.unjoin
        data: {}
        target:
          entity_id: media_player.keuken
      - wait_template: '{{ state_attr(''media_player.keuken'', ''group_members'') | count == 1 }}'
        continue_on_timeout: true
        timeout: '10'
      - data:
          volume_level: 0.08
        action: media_player.volume_set
        target:
          entity_id: media_player.keuken
      - action: media_player.volume_mute
        data:
          is_volume_muted: false
        target:
          entity_id: media_player.keuken
      - data:
          enqueue: replace
          media_content_id: FV:2/130
          media_content_type: favorite_item_id
        action: media_player.play_media
        target:
          entity_id: media_player.keuken
      alias: Play Radio Veronica on Keuken
  mode: single
- id: '1734200001010'
  alias: Keuken Screen - Openen Ochtend
  description: Open het screen in de keuken om 7:00 op weekdagen
  triggers:
  - trigger: time
    at: 07:00:00
  conditions:
  - condition: time
    weekday:
    - mon
    - tue
    - wed
    - thu
    - fri
  actions:
  - action: cover.open_cover
    target:
      entity_id: cover.screen
  mode: single
- id: '1734200001013'
  alias: Keuken Screen - Openen Weekend
  description: Open het screen in de keuken 1 uur na de ochtend routine in het weekend
  triggers:
  - trigger: state
    entity_id: automation.ochtend_keuken_routine
    attribute: last_triggered
  conditions:
  - condition: time
    weekday:
    - sat
    - sun
  actions:
  - delay:
      hours: 1
      minutes: 0
      seconds: 0
  - action: cover.open_cover
    target:
      entity_id: cover.screen
  mode: single
- id: '1734200001011'
  alias: Keuken Screen - Sluiten Avond
  description: Sluit het screen in de keuken 30 minuten voor zonsondergang
  triggers:
  - trigger: sun
    event: sunset
    offset: -00:30:00
  conditions: []
  actions:
  - action: cover.close_cover
    target:
      entity_id: cover.screen
  mode: single
- id: '1740400001'
  alias: Keuken Tablet - Scherm aan/uit bij aanwezigheid
  description: Zet het tablet scherm aan bij aanwezigheid in de keuken en uit na 5 minuten afwezigheid
  triggers:
  - trigger: state
    entity_id: binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3
    to: 'on'
    id: presence_on
  - trigger: state
    entity_id: binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3
    to: 'off'
    for:
      minutes: 5
    id: presence_off
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - presence_on
      sequence:
      - action: switch.turn_on
        target:
          entity_id: switch.pixel_tablet_scherm
    - conditions:
      - condition: trigger
        id:
        - presence_off
      sequence:
      - action: switch.turn_off
        target:
          entity_id: switch.pixel_tablet_scherm
  mode: restart
- id: '1740400002'
  alias: Keuken Tablet - Schermhelderheid op tijd
  description: Past de schermhelderheid van het tablet aan op basis van het tijdstip
  triggers:
  - trigger: time
    at: 07:00:00
    id: morning
  - trigger: time
    at: '21:00:00'
    id: evening
  - trigger: time
    at: '23:00:00'
    id: night
  conditions:
  - condition: state
    entity_id: switch.pixel_tablet_scherm
    state: 'on'
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - morning
      sequence:
      - action: number.set_value
        target:
          entity_id: number.pixel_tablet_schermhelderheid
        data:
          value: 255
    - conditions:
      - condition: trigger
        id:
        - evening
      sequence:
      - action: number.set_value
        target:
          entity_id: number.pixel_tablet_schermhelderheid
        data:
          value: 102
    - conditions:
      - condition: trigger
        id:
        - night
      sequence:
      - action: number.set_value
        target:
          entity_id: number.pixel_tablet_schermhelderheid
        data:
          value: 25
  mode: single
- id: '1740400003'
  alias: Keuken Tablet - Nachtelijke herstart en bewaking
  description: >-
    Bewaakt de Fully Kiosk browser op het keuken Pixel Tablet (172.16.3.106) en
    herstart hem elke nacht om 04:00. chg-2026-09-16-003, specificatie van
    Sander 2026-09-16.


    AANLEIDING: de vorige versie drukte blind op
    button.pixel_tablet_herstart_browser. Toen het tablet op 2026-09-08 naar een
    nieuw IP verhuisde stond die knop op unavailable en faalde de automation
    negen nachten op rij geruisloos - alleen zichtbaar als "Referenced entities
    are missing or not currently available" in het log. Elke tak hieronder
    controleert daarom EERST of de knop bestaat en beschikbaar is, en meldt het
    als dat niet zo is.


    HARDE GRENS: deze automation raakt NOOIT een stekker, schakelaar of
    netvoeding aan. Geen switch.*, geen HomeWizard, en met name NIET
    button.pixel_tablet_herstart_apparaat (dat is een apparaatreboot). Alleen
    button.pixel_tablet_herstart_browser en button.pixel_tablet_start_url_laden.


    MAXIMAAL 3 automatische browser-herstarts per venster. Het venster loopt van
    03:55 tot 03:55 en wordt geteld in counter.keuken_tablet_herstarts, een
    helper die een HA-herstart overleeft (geen template die terugvalt naar 0).
    Let op: dit is een VAST venster van 03:55 tot 03:55, geen echt voortschrijdend
    venster van 24 uur. Bij de limiet stopt hij en stuurt hij een melding.


    EFFECTCONTROLE gebruikt sensor.keuken_tablet_app_start. Die sensor bestaat
    nog NIET: de fully_kiosk integratie levert 9 sensoren en lastAppStart zit er
    niet bij (geverifieerd in components/fully_kiosk/sensor.py). Hij wordt
    toegevoegd in een aparte change die een rest-sensor op de Fully API zet.
    Zolang de sensor ontbreekt degradeert deze automation netjes: hij herstart
    wel, maar logt eerlijk "niet te verifieren" in plaats van te doen alsof, en
    de 26-uur-controle houdt zichzelf stil. Zodra de sensor bestaat werken beide
    regels vanzelf, zonder deze automation nog aan te passen.


    TESTHAAK: het event keuken_tablet_test_herstart start dezelfde tak als 04:00.
    Gebruik POST /api/events/keuken_tablet_test_herstart om het gedrag te
    bewijzen zonder tot 04:00 te wachten. Een test telt bewust mee voor de
    limiet van 3.
  triggers:
  - trigger: time
    at: '03:55:00'
    id: cap_reset
  - trigger: time
    at: '04:00:00'
    id: nachtelijke_herstart
  - trigger: event
    event_type: keuken_tablet_test_herstart
    id: nachtelijke_herstart
  - trigger: time
    at: '04:10:00'
    id: start_url_laden
  - trigger: state
    entity_id: button.pixel_tablet_herstart_browser
    to: unavailable
    for: '00:30:00'
    id: knop_offline
  - trigger: state
    entity_id: button.pixel_tablet_herstart_browser
    from: unavailable
    id: knop_online
  - trigger: time_pattern
    minutes: /30
    id: appstart_check
  # De start-URL staat hier hard omdat trigger-templates nog geen toegang hebben
  # tot de variables van de actie-sectie. Waarde live gelezen van het tablet op
  # 2026-09-16 via Fully cmd=deviceInfo -> startUrl.
  - trigger: template
    id: pagina_afwijkend
    value_template: >-
      {% set p = states('sensor.pixel_tablet_huidige_pagina') %} {{ p not in
      ['unknown', 'unavailable', ''] and p !=
      'https://keuken.bluejungle.net/dashboard-keuken/keuken' }}
    for: '00:30:00'
  conditions: []
  actions:
  - variables:
      knop: button.pixel_tablet_herstart_browser
      url_knop: button.pixel_tablet_start_url_laden
      appstart_sensor: sensor.keuken_tablet_app_start
      start_url: https://keuken.bluejungle.net/dashboard-keuken/keuken
      max_herstarts: 3
  - choose:
    - alias: 03:55 - herstartbudget vrijgeven voor het nieuwe venster
      conditions:
      - condition: trigger
        id: cap_reset
      sequence:
      - action: counter.reset
        target:
    # LET OP - NIET terugzetten naar automation.keuken_tablet_nachtelijke_herstart.
    # configuration.yaml heeft recorder.exclude.domains: [automation, updater],
    # dus logbook-regels die aan een automation-entity hangen worden door de
    # recorder WEGGEGOOID en zijn nooit terug te vinden. Empirisch bewezen op
    # 2026-09-16: een testregel op de automation-entity kwam niet in /api/logbook
    # terug, dezelfde regel op de counter-entity wel. Eis R8 van Sander is "log
    # elke herstart met zijn reden", dus alles hangt hier aan de counter.
          entity_id: counter.keuken_tablet_herstarts
      - action: input_boolean.turn_off
        target:
          entity_id: input_boolean.keuken_tablet_cap_gemeld
      - action: logbook.log
        data:
          name: Keuken tablet
          message: 'herstartbudget gereset naar 0 van {{ max_herstarts }} voor het
            venster 03:55-03:55'
          entity_id: counter.keuken_tablet_herstarts
    - alias: 04:00 - nachtelijke browser-herstart met effectcontrole
      conditions:
      - condition: trigger
        id: nachtelijke_herstart
      sequence:
      # Expliciete stop, geen kale condition. Een kale condition binnen een
      # sequence breekt alleen die sequence af en valt door naar de volgende
      # actie op het hoogste niveau (bewezen met trace e6b300a0 op 2026-09-05).
      - alias: Herstartknop niet beschikbaar -> melden en stoppen
        if:
        - condition: template
          value_template: >-
            {{ states.button.pixel_tablet_herstart_browser is none or
            states(knop) == 'unavailable' }}
        then:
        - action: notify.mobile_app_galaxy_s25_ultra
          data:
            title: Keuken tablet
            message: >-
              Nachtelijke herstart kon niet: de herstartknop van de Fully Kiosk
              browser is niet beschikbaar. De integratie heeft geen verbinding
              met het tablet op 172.16.3.106.
        - action: logbook.log
          data:
            name: Keuken tablet
            message: 'nachtelijke herstart OVERGESLAGEN - reden: herstartknop niet
              beschikbaar'
            entity_id: counter.keuken_tablet_herstarts
        - stop: Herstartknop niet beschikbaar
      - alias: Herstartlimiet bereikt -> melden en stoppen
        if:
        - condition: template
          value_template: '{{ states(''counter.keuken_tablet_herstarts'') | int(0)
            >= max_herstarts }}'
        then:
        - if:
          - condition: state
            entity_id: input_boolean.keuken_tablet_cap_gemeld
            state: 'off'
          then:
          - action: notify.mobile_app_galaxy_s25_ultra
            data:
              title: Keuken tablet
              message: >-
                Herstartlimiet bereikt: er zijn in dit venster al {{
                states('counter.keuken_tablet_herstarts') }} van {{ max_herstarts
                }} automatische browser-herstarts gedaan. Er wordt niets meer
                automatisch herstart tot 03:55. Kijk even naar het tablet.
          - action: input_boolean.turn_on
            target:
              entity_id: input_boolean.keuken_tablet_cap_gemeld
        - action: logbook.log
          data:
            name: Keuken tablet
            message: 'herstart GEBLOKKEERD - reden: limiet van {{ max_herstarts }}
              per venster bereikt'
            entity_id: counter.keuken_tablet_herstarts
        - stop: Herstartlimiet bereikt
      - variables:
          start_voor: '{{ states(appstart_sensor) }}'
          kan_verifieren: >-
            {{ states(appstart_sensor) not in ['unknown', 'unavailable', 'none',
            ''] }}
      - action: logbook.log
        data:
          name: Keuken tablet
          message: 'browser-herstart - reden: geplande nachtelijke herstart (poging
            {{ states(''counter.keuken_tablet_herstarts'') | int(0) + 1 }} van {{
            max_herstarts }} in dit venster)'
          entity_id: button.pixel_tablet_herstart_browser
      - action: counter.increment
        target:
          entity_id: counter.keuken_tablet_herstarts
      - action: button.press
        target:
          entity_id: button.pixel_tablet_herstart_browser
      - alias: Geen app-starttijd beschikbaar -> eerlijk loggen, niet doen alsof
        if:
        - condition: template
          value_template: '{{ not kan_verifieren }}'
        then:
        - action: logbook.log
          data:
            name: Keuken tablet
            message: 'herstart verstuurd maar NIET te verifieren - reden: {{ appstart_sensor
              }} bestaat niet of heeft geen waarde'
            entity_id: counter.keuken_tablet_herstarts
        - stop: Herstart verstuurd, effect niet verifieerbaar
      - wait_template: >-
          {{ states(appstart_sensor) not in ['unknown', 'unavailable',
          start_voor] }}
        timeout: '00:05:00'
        continue_on_timeout: true
      - alias: Geen nieuwe app-starttijd binnen 5 minuten -> melden
        if:
        - condition: template
          value_template: '{{ not wait.completed }}'
        then:
        - action: notify.mobile_app_galaxy_s25_ultra
          data:
            title: Keuken tablet
            message: >-
              Herstart zonder effect: de app-starttijd stond 5 minuten na de
              herstartopdracht nog steeds op {{ start_voor }}. De browser is
              waarschijnlijk vastgelopen.
        - action: logbook.log
          data:
            name: Keuken tablet
            message: herstart ZONDER EFFECT - app-starttijd onveranderd na 5 minuten
            entity_id: counter.keuken_tablet_herstarts
        - stop: Herstart zonder effect
      - action: logbook.log
        data:
          name: Keuken tablet
          message: herstart BEVESTIGD - nieuwe app-starttijd {{ states(appstart_sensor)
            }}, was {{ start_voor }}
          entity_id: button.pixel_tablet_herstart_browser
    - alias: 04:10 - start-URL laden
      conditions:
      - condition: trigger
        id: start_url_laden
      sequence:
      - alias: URL-knop niet beschikbaar -> alleen loggen, om 04:00 is al gemeld
        if:
        - condition: template
          value_template: >-
            {{ states.button.pixel_tablet_start_url_laden is none or
            states(url_knop) == 'unavailable' }}
        then:
        - action: logbook.log
          data:
            name: Keuken tablet
            message: 'start-URL laden OVERGESLAGEN - reden: knop niet beschikbaar
              (hierover is om 04:00 al een melding verstuurd)'
            entity_id: counter.keuken_tablet_herstarts
        - stop: Start-URL-knop niet beschikbaar
      - action: button.press
        target:
          entity_id: button.pixel_tablet_start_url_laden
      - action: logbook.log
        data:
          name: Keuken tablet
          message: 'start-URL geladen - reden: geplande 04:10, doel {{ start_url }}'
          entity_id: button.pixel_tablet_start_url_laden
    - alias: Herstartknop langer dan 30 minuten onbeschikbaar - eenmalig melden
      conditions:
      - condition: trigger
        id: knop_offline
      sequence:
      - alias: Al gemeld voor deze storing -> stoppen
        if:
        - condition: state
          entity_id: input_boolean.keuken_tablet_knop_offline_gemeld
          state: 'on'
        then:
        - stop: Al gemeld voor deze storing
      - action: notify.mobile_app_galaxy_s25_ultra
        data:
          title: Keuken tablet
          message: >-
            De herstartknop van het keuken tablet is al 30 minuten niet
            beschikbaar. De Fully Kiosk integratie krijgt geen verbinding met
            172.16.3.106. Nachtelijke herstart en paginabewaking liggen stil tot
            dit is opgelost.
      - action: input_boolean.turn_on
        target:
          entity_id: input_boolean.keuken_tablet_knop_offline_gemeld
      - action: logbook.log
        data:
          name: Keuken tablet
          message: 'MELDING verstuurd - reden: herstartknop langer dan 30 minuten
            onbeschikbaar'
          entity_id: button.pixel_tablet_herstart_browser
    - alias: Herstartknop weer beschikbaar - meldingsgrendel vrijgeven
      conditions:
      - condition: trigger
        id: knop_online
      sequence:
      - action: input_boolean.turn_off
        target:
          entity_id: input_boolean.keuken_tablet_knop_offline_gemeld
      - action: logbook.log
        data:
          name: Keuken tablet
          message: herstartknop weer beschikbaar - meldingsgrendel vrijgegeven
          entity_id: button.pixel_tablet_herstart_browser
    - alias: App-starttijd ouder dan 26 uur - eenmalig melden
      conditions:
      - condition: trigger
        id: appstart_check
      sequence:
      - variables:
          leeftijd_uur: >-
            {%- set s = states(appstart_sensor) -%} {%- if s not in ['unknown',
            'unavailable', 'none', ''] -%} {{ ((now() - (s | as_datetime)).total_seconds()
            / 3600) | round(1) }} {%- else -%} -1 {%- endif -%}
      - alias: Ouder dan 26 uur -> melden, anders grendel vrijgeven
        if:
        - condition: template
          value_template: '{{ leeftijd_uur | float(-1) > 26 }}'
        then:
        - if:
          - condition: state
            entity_id: input_boolean.keuken_tablet_appstart_oud_gemeld
            state: 'off'
          then:
          - action: notify.mobile_app_galaxy_s25_ultra
            data:
              title: Keuken tablet
              message: >-
                De Fully Kiosk browser op het keuken tablet draait al {{
                leeftijd_uur }} uur zonder herstart, de grens is 26 uur. De
                nachtelijke herstart heeft dus geen effect gehad.
          - action: input_boolean.turn_on
            target:
              entity_id: input_boolean.keuken_tablet_appstart_oud_gemeld
          - action: logbook.log
            data:
              name: Keuken tablet
              message: 'MELDING verstuurd - reden: app-starttijd {{ leeftijd_uur }}
                uur oud'
              entity_id: counter.keuken_tablet_herstarts
        else:
        - action: input_boolean.turn_off
          target:
            entity_id: input_boolean.keuken_tablet_appstart_oud_gemeld
    - alias: Pagina wijkt 30 minuten af binnen 07:00-22:00 - start-URL herladen
      conditions:
      - condition: trigger
        id: pagina_afwijkend
      sequence:
      - alias: Buiten het venster 07:00-22:00 -> niets doen
        if:
        - condition: not
          conditions:
          - condition: time
            after: '07:00:00'
            before: '22:00:00'
        then:
        - stop: Buiten het venster 07:00-22:00
      - alias: URL-knop niet beschikbaar -> stoppen
        if:
        - condition: template
          value_template: >-
            {{ states.button.pixel_tablet_start_url_laden is none or
            states(url_knop) == 'unavailable' }}
        then:
        - stop: Start-URL-knop niet beschikbaar
      - variables:
          afwijkende_pagina: '{{ states(''sensor.pixel_tablet_huidige_pagina'') }}'
      - action: button.press
        target:
          entity_id: button.pixel_tablet_start_url_laden
      - action: logbook.log
        data:
          name: Keuken tablet
          message: 'start-URL geladen - reden: pagina week 30 minuten af ({{ afwijkende_pagina
            }}), doel {{ start_url }}'
          entity_id: button.pixel_tablet_start_url_laden
  mode: queued
  max: 10
- id: '1737892216860'
  alias: Stalen Deur Open
  description: Spreekt een waarschuwing uit via TTS wanneer de woonkamerdeur langer dan 30 seconden open
    staat (alleen overdag)
  triggers:
  - trigger: state
    entity_id:
    - binary_sensor.deursensor_open
    from: 'off'
    to: 'on'
    for:
      hours: 0
      minutes: 0
      seconds: 30
  conditions:
  - condition: or
    conditions:
    - condition: time
      after: 07:00:00
      before: '21:00:00'
      weekday:
      - mon
      - tue
      - wed
      - thu
      - fri
    - condition: time
      after: 08:00:00
      before: '21:00:00'
      weekday:
      - sat
      - sun
  actions:
  - repeat:
      sequence:
      - action: tts.speak
        metadata: {}
        data:
          cache: true
          message: De deur van de woonkamer is niet dicht
          media_player_entity_id: media_player.eetkamer_2
        target:
          entity_id: tts.home_assistant_cloud
      - delay:
          hours: 0
          minutes: 0
          seconds: 30
      while:
      - condition: state
        entity_id: binary_sensor.deursensor_open
        state: 'on'
  mode: single
- id: '1744728869124'
  alias: Vloerverwarmingspomp Beheer
  description: 'Pomp aan bij warmtevraag, uit 15 min na einde vraag. Dagelijkse anti-vastloop cyclus van
    5 min via een TIJD-trigger. Stuurt sinds 2026-08-30 het STROOMBLOK-stopcontact ch6 aan (switch.stroomblok_6)
    i.p.v. de Innr-plug: het stroomblok schakelt en meet zelf, dus de Innr is overbodig en kan elders
    gebruikt worden. Verifieert dat de pomp echt stroom trekt.'
  triggers:
  - trigger: numeric_state
    entity_id: sensor.woonkamer_verwarmen
    above: 0
    id: demand_on
  - trigger: numeric_state
    entity_id: sensor.woonkamer_verwarmen
    below: 1
    for:
      minutes: 15
    id: demand_off
  - trigger: time
    at: '11:00:00'
    id: exercise
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id: demand_on
      sequence:
      - action: switch.turn_on
        target:
          entity_id: switch.stroomblok_6
      - action: input_datetime.set_datetime
        target:
          entity_id: input_datetime.vloerpomp_laatste_run
        data:
          datetime: '{{ now().strftime(''%Y-%m-%d %H:%M:%S'') }}'
    - conditions:
      - condition: trigger
        id: demand_off
      sequence:
      - action: switch.turn_off
        target:
          entity_id: switch.stroomblok_6
    - conditions:
      - condition: trigger
        id: exercise
      - condition: template
        value_template: '{{ (now().timestamp() - state_attr(''input_datetime.vloerpomp_laatste_run'',''timestamp''))
          > 86400 }}'
      sequence:
      - action: switch.turn_on
        target:
          entity_id: switch.stroomblok_6
      - delay:
          seconds: 45
      - if:
        - condition: numeric_state
          entity_id: sensor.stroomblok_electric_consumption_w_6
          above: 10
        then:
        - action: input_boolean.turn_off
          target:
            entity_id: input_boolean.vloerpomp_storing
        else:
        - action: input_boolean.turn_on
          target:
            entity_id: input_boolean.vloerpomp_storing
        - action: notify.mobile_app_galaxy_s25_ultra
          data:
            title: Vloerverwarmingspomp
            message: Pomp aangestuurd maar trekt <10W. Mogelijk defect of stekker eruit.
      - delay:
          minutes: 5
      - action: switch.turn_off
        target:
          entity_id: switch.stroomblok_6
      - action: input_datetime.set_datetime
        target:
          entity_id: input_datetime.vloerpomp_laatste_run
        data:
          datetime: '{{ now().strftime(''%Y-%m-%d %H:%M:%S'') }}'
  mode: queued
  max: 5
- id: '1734200001001'
  alias: Kantoor Ochtend - Klimaat
  description: 'Verwarm kantoor bij <18°C of koel bij ≥23,5°C om 8:30 op werkdagen
    als Sander thuis is.

    chg-2026-09-07-001: de KOEL-AANZETDREMPEL ging van 22,99 naar 23,49 (bij een sensor
    met 2 decimalen dus exact >= 23,50) en er kwam een VERSHEIDSCONTROLE bij. Reden:
    sensor.kantoor_temperatuur is geen ruisende sensor maar een Tado-cloudwaarde die
    HA eens per 30 minuten ophaalt (n=466 over 10 dagen, p50 interval 1801 s). De
    meting achter de HA-state is daardoor mediaan 38,8 min oud en p90 48,6 min. Op
    2026-09-04 stond HA nog op 23,02 (gemeten 07:05:51Z) terwijl Tado al 22,79 had
    liggen (gemeten 07:31:57Z, bijna 22 min voor het besluit); dat verschil zette de
    airco 8 uur 22 min aan. Een `for:`-dwell lost dit NIET op - de drempel was 28
    minuten aaneengesloten waar.

    DAAROM, in deze volgorde: (1) `homeassistant.update_entity` haalt eerst een VERSE
    meting op bij Tado - gemeten 1,07 s, en dat brengt de meetleeftijd terug naar
    mediaan 8,3 min; (2) `meting_vers` is een DODE-FEED-DETECTOR, geen
    versheidseis: hij blokkeert pas als Tado al 2 uur niets meer gepubliceerd heeft.
    2 uur en niet 30 min, omdat Tado zelf maar eens per ~33 min publiceert (p50 33,6 /
    p90 39,6 / max 91,8 min over 5 dagen); een drempel van 30 min zou door de
    inspection-paradox 18% van alle GEZONDE beslissingen blokkeren, en voor de
    ochtendroutine - die maar een keer per dag vuurt - is dat 1 werkdag op de 5,5 zonder
    klimaat. Bij 2 uur is dat 0% op gemeten data. Het VERSEN doet update_entity, niet
    deze check. Dit is het vangnet voor `continue_on_error: true` - zonder die check zou een
    mislukte refresh stilletjes terugvallen op het oude gedrag (een mislukte
    coordinator-refresh gooit GEEN fout, hij zet alleen last_update_success op false,
    dus zonder deze check is het fail-OPEN). De vorm `as_timestamp(..., 0)` maakt een
    ontbrekend of kapot attribuut FAIL-CLOSED: de leeftijd wordt dan enorm en er start
    dus niets; (3) de dodeband van 0,5 degC is
    afgeleid uit de gemeten drift van p99 0,49 degC per 30 minuten. Effect op 10 dagen
    echte data tussen 08:00 en 18:00: 3 koeldagen in plaats van 7 - eruit vallen
    precies de randgevallen (dagmaxima 23,21 / 23,06 / 23,02 / 23,46), erin blijven
    de echt warme dagen (25,31 / 24,42 / 23,85).

    De VERWARM-drempel blijft bewust op <18 degC en krijgt alleen de versheidscontrole.
    Er is geen data om er een dodeband onder te leggen (0 van 466 metingen kwam onder
    18,0 degC, laagste 20,44), de kosten zijn asymmetrisch (een gemiste verwarmstart
    = een hele dag koud kantoor) en climate.kantoor heeft min_temp 18,0 - een drempel
    van 17,5 zou onder het minimum van het apparaat zelf liggen. Heroverwegen zodra
    er winterdata is.

    De `condition: or` voorfilter op temperatuur is verwijderd: condities worden VOOR
    de acties geevalueerd, dus die zou nog op de oude, muffe waarde beslissen. De
    logica zat toch al in de choose-branches, dus functioneel verandert er niets.

    De setpoints hier (heat 20 / cool 21) zijn LEIDEND: 1747224001001 is er in ronde 2
    op gelijkgetrokken. Daarvoor zette die bij aanwezigheid cool 24 over deze cool 21
    heen, waardoor de eerste aanwezigheids-latch de ochtendroutine meteen ongedaan
    maakte. Wijzig deze waarden nooit los van 1747224001001 - dat geldt sinds
    chg-2026-09-07-001 ook voor de drempel 23,49 en voor de versheidscontrole.

    '
  triggers:
  - trigger: time
    at: 08:30:00
  conditions:
  - condition: time
    weekday:
    - mon
    - tue
    - wed
    - thu
    - fri
  - condition: state
    entity_id: person.sander_van_der_heijden
    state: home
  actions:
  - action: homeassistant.update_entity
    continue_on_error: true
    target:
      entity_id:
      - sensor.kantoor_temperatuur
      - climate.kantoor
  - variables:
      meting_vers: "{{ (as_timestamp(now()) - as_timestamp(state_attr('sensor.kantoor_temperatuur', 'time'), 0)) < 7200 }}"
  - choose:
    - conditions:
      - condition: template
        value_template: "{{ meting_vers | bool(false) }}"
      - condition: numeric_state
        entity_id: sensor.kantoor_temperatuur
        below: 18
      sequence:
      - action: climate.set_hvac_mode
        target:
          entity_id: climate.kantoor
        data:
          hvac_mode: heat
      - action: climate.set_temperature
        target:
          entity_id: climate.kantoor
        data:
          temperature: 20
      - action: climate.set_swing_mode
        target:
          entity_id: climate.kantoor
        data:
          swing_mode: both
    - conditions:
      - condition: template
        value_template: "{{ meting_vers | bool(false) }}"
      - condition: numeric_state
        entity_id: sensor.kantoor_temperatuur
        above: 23.49
      sequence:
      - action: climate.set_hvac_mode
        target:
          entity_id: climate.kantoor
        data:
          hvac_mode: cool
      - action: climate.set_temperature
        target:
          entity_id: climate.kantoor
        data:
          temperature: 21
      - action: climate.set_swing_mode
        target:
          entity_id: climate.kantoor
        data:
          swing_mode: both
  mode: single
- id: '1747987200001'
  alias: Kantoor Avond - Klimaat Uit
  description: 'Zet de kantoor-airco om 18:00 uit, ALLE ZEVEN DAGEN (tegenhanger van
    de ochtend-automation 1734200001001, die zelf wel werkdag-only is).

    chg-2026-08-30-005: de weekday-conditie mon-vri is hier bewust VERWIJDERD. Sinds
    de aanwezigheidssensor live is kan de occupancy-pair (1747224001001) de airco ook
    in het weekend aanzetten, en Afwezig zet bewust nooit hvac_mode off. Met een
    werkdag-only uitschakelaar bleef een split-unit dan het hele weekend in cool met
    swing draaien in een bewoond huis. Zet de weekday-conditie hier niet terug zonder
    ook de aanzet-branches van 1747224001001 opnieuw te bekijken.

    '
  triggers:
  - trigger: time
    at: '18:00:00'
  conditions:
  - condition: not
    conditions:
    - condition: state
      entity_id: climate.kantoor
      state: 'off'
  actions:
  - action: climate.set_hvac_mode
    target:
      entity_id: climate.kantoor
    data:
      hvac_mode: 'off'
  mode: single
- id: '1734200001002'
  alias: Kantoor Ochtend - PC Opstarten
  description: Start werkstation via Wake on LAN om 8:45 op werkdagen als Sander thuis is
  triggers:
  - trigger: time
    at: 08:45:00
  conditions:
  - condition: time
    weekday:
    - mon
    - tue
    - wed
    - thu
    - fri
  - condition: state
    entity_id: person.sander_van_der_heijden
    state: home
  actions:
  - action: button.press
    target:
      entity_id: button.wake_on_lan_d8_bb_c1_94_90_c0
  mode: single
- id: '1734200001003'
  alias: Kantoor Focus Mode - Lichten Dimmen
  description: Dim kantoorverlichting naar 50% tijdens agenda-afspraken (focus mode)
  triggers:
  - trigger: state
    entity_id: calendar.sheijden_gmail_com
    to: 'on'
  conditions:
  - condition: state
    entity_id: person.sander_van_der_heijden
    state: home
  - condition: state
    entity_id: device_tracker.vdhws01
    state: home
  actions:
  - action: light.turn_on
    target:
      entity_id:
      - light.kantoor
    data:
      brightness_pct: 50
      transition: 5
  mode: single
- id: '1734200001004'
  alias: Kantoor Focus Mode - Lichten Herstellen
  description: Herstel kantoorverlichting na afloop van agenda-afspraak
  triggers:
  - trigger: state
    entity_id: calendar.sheijden_gmail_com
    to: 'off'
  conditions:
  - condition: state
    entity_id: person.sander_van_der_heijden
    state: home
  - condition: state
    entity_id: light.kantoor
    state: 'on'
  actions:
  - action: light.turn_on
    target:
      entity_id:
      - light.kantoor
    data:
      brightness_pct: 100
      transition: 5
  mode: single
- id: '1734200001012'
  alias: Kantoor Adaptieve Verlichting
  description: |-
    Regelt light.kantoor traploos op het GEDEMPTE omgevingslicht, zolang het kantoor bezet is.

    HERBOUWD 2026-09-09 (chg-2026-09-09-004) NA EEN QA-AFKEURING. Lees dit voor je iets wijzigt.

    WAT ER MIS WAS: de vorige versie schakelde de lamp 9 keer volledig aan/uit in 4,9 uur bezette
    daglichturen op 2026-09-09, plus 8 tussentijdse dimstappen: 17 service calls. De dodeband van
    10 punten bewaakte ALLEEN de dimstap, NOOIT de aan/uit-beslissing. Die aan/uit-beslissing hing
    aan een hysteresebandje van 50 lux (uit boven 600, aan onder 550), terwijl de mediane stap
    tussen twee opeenvolgende metingen op die dag 440 lux was (p90 801, max 1504). De ruis was dus
    ongeveer 9x de hele hysteresband. Klapperen was onvermijdelijk.

    WAT ER NIET MIS WAS: de terugkoppeling van de lamp op zichzelf. Die analyse klopte
    (lusversterking <= 0,28). Het probleem was INGANGSRUIS, niet zelfterugkoppeling. Een
    stabiliteitsbewijs over een lus zegt niets over de ruis die je erin stopt.

    DE SLEUTELMETING DIE HET ONTWERP BEPAALDE: een IDEALE regelaar - eentje die de echte
    omgevingslux perfect kent, zonder ruis - zou op 2026-09-09 ZEVEN keer aan/uit zijn gegaan
    tijdens bezetting. De echte omgevingslux liep namelijk van 75 tot 1618 lux en kruiste de
    600-lux grens zeven keer echt. De oude versie deed er 9. Het overschot door klapperen was dus
    maar 2, niet 9. Daarom is FILTEREN NIET DE HOOFDOPLOSSING: elke filterinstelling die het
    aantal schakelingen echt omlaag bracht, maakte de regelaar slechter - een venster van 30
    minuten gaf 1 service call maar liet de gebruiker 65 minuten in een donker kantoor zitten.

    DE ECHTE OPLOSSING: niet meer op daglicht uitschakelen. Zolang het kantoor bezet is blijft de
    lamp AAN en zakt hij via de curve terug naar een bodem van 10%. De zeven echte
    daglichtovergangen worden daarmee onzichtbare dimstappen in plaats van schokkerige aan/uit
    sprongen. Resultaat op dezelfde echte meetreeks: 17 -> 10 service calls, 9 -> 3 aan/uit
    overgangen, en die 3 zijn ALLEMAAL aanwezigheidsovergangen, geen daglicht. Nul minuten
    'donker en toch uit'. Nauwkeurigheid vrijwel gelijk (gemiddelde afwijking 11,3 -> 12,1 punt
    op de momenten dat de lamp hoort te branden).

    LET OP - AFWIJKING VAN DE OORSPRONKELIJKE WENS: de gebruiker vroeg oorspronkelijk '600 lux ->
    lamp uit'. Dat is NIET meer wat er gebeurt en dat is bewust en goedgekeurd door de gebruiker
    op 2026-09-09. Boven 600 lux blijft de lamp op 10% staan. Echt uitgaan doet hij alleen bij
    aanhoudend fel licht (gedempt > 1500 lux gedurende 15 minuten) of bij afwezigheid. Reden: de
    wens en een hysteresband die tegen 440 lux ruis bestand is passen niet samen binnen een
    regelbereik van 0-600 lux, en op 10% is een groep van zes Hue-lampen onzichtbaar in een kamer
    van meer dan 600 lux.

    INGANG: sensor.kantoor_lux_gedempt, een filter-helper (time_simple_moving_average, venster 10
    minuten) op sensor.multisensor_illuminance. NIET de ruwe sensor gebruiken. Het venster van 10
    minuten brengt de piek-tot-piek uitslag binnen 10 minuten terug van 1616 naar 391 lux. 15 en
    30 minuten dempen meer maar laten de regelaar verhongeren.

    DRIE BEVEILIGINGEN, ELK MET EEN REDEN:
    1. MINIMUM STUURINTERVAL van 300 s, gemeten aan states.light.kantoor.last_updated. Let op:
       last_updated loopt WEL mee met attribuutwijzigingen (brightness), last_changed niet. Deze
       ene grendel doet drie dingen tegelijk: hij beperkt het klapperen, hij voorkomt dat br_now
       wordt afgelezen tijdens de 5 seconden Hue-overgang (toen onbetrouwbaar), en hij onderdrukt
       het Hue-groepsartefact van 08:32:40.711 uit -> 08:32:41.723 aan -> 08:32:55.678 uit, waarbij
       de groep zichzelf even opnieuw als 'aan' meldde terwijl de zes leden uitdoofden.
    2. DODEBAND van 15 punten op de dimstap.
    3. AANWEZIGHEID: de uit-tak eist dat kantoor_bezet 10 minuten onafgebroken off is. De
       debounce van de gedeelde template sensor zelf (45 s aan / 15 min uit) is BEWUST NIET
       aangepast - die wordt door andere automations gebruikt.

    REGIMES: getest op gebroken bewolking (2026-09-09, mediane stap 440 lux) en op bewolkt/kalm
    (2026-09-07/08, mediane stap 108 lux en een meetinterval van 3616 s = puur het uurbericht).
    Dezelfde sensor met dezelfde instellingen levert dus totaal verschillende ingangen op. NIET
    getest: aanhoudend strak blauwe hemel - die kwam in de opgenomen historie niet voor, dus de
    1500-lux klep is alleen in simulatie beproefd.

    DE VOLGORDE VAN DE TAKKEN IS FUNCTIONEEL - NIET HERSCHIKKEN. De veiligheidsklep (tak 3)
    staat BEWUST BOVEN de 300 s grendel (tak 4). In de eerste versie stond hij eronder en dan kon
    de klep worden opgeslokt: schrijft iets anders binnen 300 s naar light.kantoor, dan valt de
    klepmelding in de grendel en gaat verloren. En omdat de fel-trigger een numeric_state is,
    vuurt hij pas opnieuw na een nieuwe overschrijding - dus tot de schemering gebeurt er niets
    meer. Aangetoond door change-qa: op een gesimuleerde heldere dag vuurt de klep precies 1x als
    niets stoort, en 0x met 1 vreemde schrijfactie 60 s ervoor. Dezelfde reden waarom de
    afwezigheidstak (tak 1) ook boven de grendel staat. Een veiligheidsvoorziening mag nooit
    onderdrukt kunnen worden door een snelheidsbegrenzer.

    De grendel logt zijn weigering nu ook, maar ALLEEN als die weigering ergens toe deed (de lamp
    zou zijn aangegaan, of het doel lag meer dan de dodeband van de huidige stand). Zo'n regel
    heet GESMOORD in het logboek en vermeldt sinds_cmd. Zonder die regel is 'de grendel heeft iets
    tegengehouden' niet te onderscheiden van 'er was niets te doen'.

    KAPOTTE SENSOR: bij unknown/unavailable doet deze automation NIETS. | default(0) vangt die
    strings NIET af, daarom | float(-1) plus een expliciete stop als eerste tak.

    ── WIJZIGING 2026-09-09 (chg-2026-09-09-008) — LEES DIT ────────────────────────

    DRIE DEFECTEN GEREPAREERD, ALLE DRIE LIVE WAARGENOMEN OP 2026-09-09 (tijden lokaal, CEST):

    D1. DE AAN-TAK STOND ONDER DE 300 s GRENDEL. Waargenomen:
          20:39:45.752  ruwe PIR AAN   (er loopt iemand binnen)
          20:39:54.361  lamp AAN       (met de hand, geen enkele trace van deze automation)
          20:40:01.452  lamp UIT       (deze automation, afwezigheidstak, 7,1 s later)
          20:40:30.753  bezet AAN      (precies 45,0 s na de PIR — de delay_on)
          20:44:13.158  lamp AAN       (Atlas greep met de hand in, op 62%)
        Vier minuten en elf seconden donker bij 197 lux gedempt. De grendel weigerde te
        herstellen omdat de automation 29 s eerder zélf naar light.kantoor had geschreven.
        Zonder handmatig ingrijpen was het tot de tick van 20:50 donker gebleven.

    D2. DE AFWEZIGHEIDSTAK SCHAKELDE UIT TERWIJL DE RUWE PIR AL AAN STOND. Op het moment
        van de uit-actie (20:40:01) stond binary_sensor.multisensor_motion_detection al
        15,7 SECONDEN op 'on'. De automation deed het licht uit in een kamer waarvan de
        bewegingsmelder op dat moment actief aanwezigheid meldde. Dit is het echte defect;
        alleen deze grendel-reparatie was niet genoeg geweest.

    D3. GEEN BESEF VAN 'IEMAND HEEFT DIT NET ZELF GEDAAN'. Zie de eigenaarschap-vlag hieronder.

    WAT ER IS VERANDERD:

    1. SNELHEID. Nieuwe trigger 'pir' op de RUWE binary_sensor.multisensor_motion_detection.
       De delay_on van 45 s op binary_sensor.kantoor_bezet is BEWUST NIET AANGERAAKT: die is
       in chg-2026-08-30-005 ronde 2 gekalibreerd op de meetcliff van de FGMS-001 (eigen
       reset ~30 s) om 'bleef' van 'liep door' te scheiden, en het klimaatpaar hangt eraan.
       Verkorten zou de airco op doorloopjes laten aanslaan. De ruwe PIR is effectief direct.

    2. DE AAN-TAK STAAT NU BOVEN DE GRENDEL, als eerste functionele tak. Dat is exact het
       principe dat hierboven al voor tak 1 en de veiligheidsklep is opgeschreven: 'Een
       veiligheidsvoorziening mag nooit onderdrukt kunnen worden door een snelheidsbegrenzer.'
       Licht teruggeven aan een BEZETTE, DONKERE kamer hoort in die categorie.
       GEEN NIEUW KLAPPERRISICO: de enige snelle uit-paden zijn de afwezigheidstak (eist
       bezet 10 min off ÉN ruwe PIR off ÉN eigenaarschap) en de felklep (eist 15 min
       aanhoudend >1500 lux). Een ongelimiteerde aan-tak kan tegen geen van beide pingpongen.

    3. RUWE-PIR-GRENDEL OP DE AFWEZIGHEIDSTAKKEN. Die eisen nu óók dat de ruwe PIR 'off' is.
       Natuurkundige onderbouwing: staat de ruwe PIR nú aan, dan IS er iemand, wat de
       gedempte template ook zegt. GEEN nieuw 'stuck-on' risico: kantoor_bezet is uit
       diezelfde PIR afgeleid, dus een blijvend hoge PIR zet bezet al op 'on' en blokkeert
       de afwezigheidstak vandaag al.

    4. EIGENAARSCHAP-VLAG input_boolean.kantoor_lamp_door_automatisering, dezelfde inversie
       als kantoor_screen_auto_dicht bij het screen.
         AAN  = deze automation heeft de lamp aangedaan en mag hem dus ook uitdoen.
         UIT  = de lamp is uit, óf iemand anders heeft hem aangedaan → afblijven.
       De vlag wordt gezet VÓÓR de eigen light.turn_on (volgorde is functioneel: anders
       bestaat er een venster waarin de eigen actie er extern uitziet). Een aparte kleine
       automation 'Kantoor Lamp Eigenaarschap' wist de vlag zodra de lamp 10 s onafgebroken
       uit is — die 10 s is er tegen het Hue-groepsartefact dat hierboven is beschreven
       (de groep meldt zichzelf midden in een fade van 5 s heel even opnieuw als 'on').

    5. DE VLAG REMT ALLEEN DE UIT-BESLISSING. Bewuste beperking. De helderheidsregeling
       loopt gewoon door op een met de hand aangezette lamp, want adaptief dimmen is juist
       de functie die de gebruiker wil; zou de vlag ook dat blokkeren, dan legt één
       handmatige druk op de knop de regeling de hele dag stil. De felklep negeert de vlag
       eveneens: die eist 15 minuten aanhoudend fel licht en kan dus onmogelijk seconden na
       een menselijke handeling vuren — en dát was de klacht.

    6. DOORLOOPGEDRAG, EXPLICIET. Nieuwe trigger 'pir_uit' (ruwe PIR 3 min off) zodat de
       afwezigheidstak niet op de tick van /10 hoeft te wachten.
         Kort bezoek (<45 s, bezet latcht nooit): lamp ~1 s aan, ~3,5-4 min later uit.
           Dat is de aanvaarde prijs van onmiddellijk licht en veel beter dan de tot 10
           minuten die een pure /10 tick zou geven.
         Langer bezoek (>=45 s, bezet latcht wél): bezet houdt 15 min vast plus 10 min
           dwell, dus lamp ~25 min na vertrek uit. DAT IS BESTAAND GEDRAG van de gedeelde
           gedempte sensor en is hier NIET veranderd (delay_off is gedeeld met klimaat).

    7. De aan-tak gebruikt transition 1 in plaats van 5. 'Bijna direct' hoort ook visueel
       direct te zijn; bijstellen en uitschakelen houden transition 5.

    AFBREEKCRITERIUM VERVANGEN. Het oude luidde '>=15 min bezet onder 400 lux met de lamp
    uit'. Dat kon STRUCTUREEL NOOIT VUREN: de enige periodieke trigger is time_pattern /10,
    dus de maximaal waarneembare blootstelling tussen twee evaluaties is ~9,5 min. Het nieuwe
    criterium meet de tijd-tot-herstel: als na een PIR-flank off->on met de lamp uit en
    ambient<1200 de lamp niet binnen 30 s aan staat, is dit fout.

    D4. DE REGELAAR OVERRULEDE OOK EEN HANDMATIGE UIT-ACTIE — ONTDEKT TIJDENS DEZE WIJZIGING,
        NIET GEMELD IN DE OPDRACHT. Waargenomen op 2026-09-09:
          22:25:17  lamp UIT (met de hand; de gebruiker zat op dat moment in het kantoor,
                    binary_sensor.kantoor_bezet stond onafgebroken 'on' sinds 21:15:41)
          ~22:29    automation.kantoor_adaptieve_verlichting werd UITGEZET
        Om 22:31 was de live toestand: bezet=on, lamp=off, ambient=0, doel=100%,
        mag_sturen=True. Met de automation aan zou de lamp bij de eerstvolgende trigger dus
        op 100% zijn gesprongen, boven op iemand die het licht net bewust had uitgedaan.
        De meest waarschijnlijke lezing is dat de gebruiker de automation daarom heeft
        uitgezet. Hard te bewijzen is dat niet: recorder.exclude bevat het hele domein
        'automation', dus er is geen historie van deze entiteit.

        BELANGRIJK: de hierboven beschreven hoisting maakt dit ERGER, niet beter. Vóór deze
        wijziging ving de 300 s grendel de terugschakeling nog op (sinds_cmd was 283 s op de
        tick van 22:30, dus GESMOORD tot 22:40). Met de aan-tak boven de grendel zou de lamp
        binnen ~1 s terugkomen, en óók nog op elke PIR-flank. Een reparatie van de aan-kant
        die de uit-kant stukmaakt is geen reparatie.

    DAAROM IS HET EIGENAARSCHAP SYMMETRISCH GEMAAKT. Tweede vlag:
    input_boolean.kantoor_lamp_handmatig_uit = 'iemand heeft deze lamp met de hand
    uitgedaan tijdens deze aanwezigheidssessie — niet opnieuw aandoen.'

      ZETTEN: de regelaar wist zijn eigen eigenaarschapsvlag VLAK VOOR elk eigen
        light.turn_off (afwezigheidstak én felklep). Gaat de lamp daarna uit terwijl de
        eigenaarschapsvlag NOG STEEDS aan staat, dan heeft de regelaar die uit-actie dus
        niet gegeven en was het iemand anders -> handmatig_uit gaat aan.
        Dit is dezelfde inversie als de aan-kant, alleen omgekeerd, en hij vraagt geen
        enkele kennis van HA-context of user_id (een Hue-wandschakelaar of de Hue-app
        levert helemaal geen HA-context, dus daar kun je niet op bouwen).
      WISSEN: zodra het kantoor 10 minuten onafgebroken leeg is. Dat is de natuurlijke
        grens van een aanwezigheidssessie: wie weggaat en terugkomt, krijgt gewoon weer
        licht. Wie blijft zitten, houdt zijn donkere kamer.

    MOOIE BIJVANGST: automation 1734200001009 'Kantoor Einde Werkdag - Lichten Uit' doet het
    licht uit als het werkstation na 17:00 vijf minuten offline is. Die uit-actie komt niet
    van de regelaar, dus hij zet nu handmatig_uit aan en de regelaar laat het licht uit —
    ook als de gebruiker nog door de kamer loopt. Zonder deze vlag zou de ruwe PIR dat
    einde-werkdag-commando binnen een seconde ongedaan hebben gemaakt.
  triggers:
  - trigger: state
    entity_id: sensor.kantoor_lux_gedempt
    id: lux
  - trigger: state
    entity_id: binary_sensor.multisensor_motion_detection
    to: 'on'
    id: pir
  - trigger: state
    entity_id: binary_sensor.multisensor_motion_detection
    to: 'off'
    for:
      hours: 0
      minutes: 3
      seconds: 0
    id: pir_uit
  - trigger: state
    entity_id: binary_sensor.kantoor_bezet
    to: 'on'
    id: bezet_aan
  - trigger: state
    entity_id: binary_sensor.kantoor_bezet
    from: 'on'
    to: 'off'
    for:
      hours: 0
      minutes: 10
      seconds: 0
    id: bezet_uit
  - trigger: numeric_state
    entity_id: sensor.kantoor_lux_gedempt
    above: 1500
    for:
      hours: 0
      minutes: 15
      seconds: 0
    id: fel
  - trigger: time_pattern
    minutes: /10
    id: tick
  conditions: []
  actions:
  - variables:
      k: 0.6
      bodem: 10
      dodeband: 15
      min_interval: 300
      fel_terug: 1200
      lux: '{{ states(''sensor.kantoor_lux_gedempt'') | float(-1) }}'
      br_now: '{% if is_state(''light.kantoor'',''on'') %}{{ ((state_attr(''light.kantoor'',''brightness'')
        | float(0)) / 2.55) | round(0) | int }}{% else %}0{% endif %}'
      ambient: '{{ [ lux - k * br_now, 0 ] | max | round(0) }}'
      curve: '{{ (100 * (1 - ([ ambient, 600 ] | min) / 600) ** 1.2) | round(0) }}'
      target: '{{ [ curve, bodem ] | max | int }}'
      sinds_cmd: '{% if states.light.kantoor %}{{ (as_timestamp(now()) - as_timestamp(states.light.kantoor.last_updated))
        | int(9999) }}{% else %}9999{% endif %}'
      mag_sturen: '{{ sinds_cmd | int(9999) >= min_interval }}'
      pir_aan: '{{ is_state(''binary_sensor.multisensor_motion_detection'',''on'') }}'
      auto_eigenaar: '{{ is_state(''input_boolean.kantoor_lamp_door_automatisering'',''on'') }}'
      handmatig_uit: '{{ is_state(''input_boolean.kantoor_lamp_handmatig_uit'',''on'') }}'
  - choose:
    - alias: Lichtsensor onbruikbaar - bewust niets doen
      conditions:
      - condition: template
        value_template: '{{ lux < 0 }}'
      sequence:
      - stop: Gedempte lux unknown/unavailable - niets doen
    - alias: Aanwezig en de lamp is uit - onmiddellijk aan (STAAT BEWUST BOVEN DE GRENDEL)
      conditions:
      - condition: or
        conditions:
        - condition: state
          entity_id: binary_sensor.multisensor_motion_detection
          state: 'on'
        - condition: state
          entity_id: binary_sensor.kantoor_bezet
          state: 'on'
      - condition: state
        entity_id: light.kantoor
        state: 'off'
      - condition: template
        value_template: '{{ ambient < fel_terug }}'
      - condition: template
        value_template: '{{ not handmatig_uit }}'
      sequence:
      - action: input_boolean.turn_on
        target:
          entity_id: input_boolean.kantoor_lamp_door_automatisering
      - action: light.turn_on
        target:
          entity_id: light.kantoor
        data:
          brightness_pct: '{{ target }}'
          transition: 1
      - action: logbook.log
        data:
          name: Kantoor Adaptief
          message: aan op {{ target }}% (trigger {{ trigger.id | default('?') }}, ambient {{ ambient }}
            lux, pir {{ pir_aan }}, sinds_cmd {{ sinds_cmd }} s)
          entity_id: light.kantoor
    - alias: Kantoor 10 min onbezet, PIR stil en de lamp is van ons - lamp uit
      conditions:
      - condition: state
        entity_id: binary_sensor.kantoor_bezet
        state: 'off'
        for:
          minutes: 10
      - condition: state
        entity_id: binary_sensor.multisensor_motion_detection
        state: 'off'
      - condition: template
        value_template: '{{ auto_eigenaar }}'
      sequence:
      - if:
        - condition: state
          entity_id: light.kantoor
          state: 'on'
        then:
        - action: input_boolean.turn_off
          target:
            entity_id: input_boolean.kantoor_lamp_door_automatisering
        - action: light.turn_off
          target:
            entity_id: light.kantoor
          data:
            transition: 5
        - action: logbook.log
          data:
            name: Kantoor Adaptief
            message: uit wegens afwezigheid (trigger {{ trigger.id | default('?') }}, ambient {{ ambient
              }})
            entity_id: light.kantoor
    - alias: Onbezet of de lamp is niet van ons - met rust laten
      conditions:
      - condition: state
        entity_id: binary_sensor.kantoor_bezet
        state: 'off'
      - condition: state
        entity_id: binary_sensor.multisensor_motion_detection
        state: 'off'
      sequence:
      - if:
        - condition: template
          value_template: '{{ is_state(''light.kantoor'',''on'') and not auto_eigenaar }}'
        - condition: state
          entity_id: binary_sensor.kantoor_bezet
          state: 'off'
          for:
            minutes: 10
        then:
        - action: logbook.log
          data:
            name: Kantoor Adaptief
            message: 'MET RUST GELATEN: kantoor is onbezet maar deze lamp is niet door de automatisering
              aangezet, dus hij blijft branden (trigger {{ trigger.id | default(''?'') }})'
            entity_id: light.kantoor
      - if:
        - condition: state
          entity_id: binary_sensor.kantoor_bezet
          state: 'off'
          for:
            minutes: 10
        - condition: template
          value_template: '{{ handmatig_uit }}'
        then:
        - action: input_boolean.turn_off
          target:
            entity_id: input_boolean.kantoor_lamp_handmatig_uit
        - action: logbook.log
          data:
            name: Kantoor Adaptief
            message: handmatig-uit vlag gewist - kantoor is 10 min leeg, nieuwe aanwezigheidssessie
            entity_id: light.kantoor
      - stop: Onbezet - binnen de dwell, of de lamp is niet van de automatisering
    - alias: Aanhoudend fel daglicht - lamp echt uit (veiligheidsklep)
      conditions:
      - condition: trigger
        id: fel
      - condition: state
        entity_id: light.kantoor
        state: 'on'
      sequence:
      - action: input_boolean.turn_off
        target:
          entity_id: input_boolean.kantoor_lamp_door_automatisering
      - action: light.turn_off
        target:
          entity_id: light.kantoor
        data:
          transition: 5
      - action: logbook.log
        data:
          name: Kantoor Adaptief
          message: 'VEILIGHEIDSKLEP: uit wegens aanhoudend fel licht (ambient {{ ambient }} lux, 15 min
            boven 1500, sinds_cmd {{ sinds_cmd }} s)'
          entity_id: light.kantoor
    - alias: Te kort na de vorige stuuractie - niets doen (anti-klapper grendel)
      conditions:
      - condition: template
        value_template: '{{ not mag_sturen }}'
      sequence:
      - if:
        - condition: template
          value_template: '{{ not is_state(''light.kantoor'',''on'') or (target - br_now) | abs >= dodeband
            }}'
        then:
        - action: logbook.log
          data:
            name: Kantoor Adaptief
            message: 'GESMOORD door de 300 s grendel: trigger {{ trigger.id | default(''?'') }}, sinds_cmd
              {{ sinds_cmd }} s, ambient {{ ambient }} lux, br_now {{ br_now }}% -> doel {{ target }}%'
            entity_id: light.kantoor
      - stop: Minimum stuurinterval van 300 s nog niet verstreken
    - alias: Lamp aan en meer dan 15 punten van het doel - bijstellen
      conditions:
      - condition: state
        entity_id: light.kantoor
        state: 'on'
      - condition: template
        value_template: '{{ (target - br_now) | abs >= dodeband }}'
      sequence:
      - action: light.turn_on
        target:
          entity_id: light.kantoor
        data:
          brightness_pct: '{{ target }}'
          transition: 5
      - action: logbook.log
        data:
          name: Kantoor Adaptief
          message: bijgesteld {{ br_now }}% -> {{ target }}% (trigger {{ trigger.id | default('?') }},
            ambient {{ ambient }} lux)
          entity_id: light.kantoor
  mode: single
  max_exceeded: silent
- id: '1757450000001'
  alias: Kantoor Lamp Eigenaarschap
  description: |-
    Onderhoudt input_boolean.kantoor_lamp_door_automatisering, de eigenaarschap-vlag van
    light.kantoor. Toegevoegd in chg-2026-09-09-008.

    BETEKENIS VAN DE VLAG:
      AAN  = 'Kantoor Adaptieve Verlichting' heeft de lamp zelf aangezet en mag hem dus ook
             weer uitzetten bij afwezigheid.
      UIT  = de lamp is uit, OF iemand anders heeft hem aangezet (Hue-app, wandschakelaar,
             dashboard, een andere automation) -> de adaptieve automation laat hem met rust.

    WAAROM DIT EEN APARTE AUTOMATION IS: de adaptieve automation draait mode:single. Zou je
    deze light.kantoor-trigger daar toevoegen, dan zou een lopende run de eigen lampcommando's
    laten vallen en zou de vlag scheef kunnen komen te staan. Los houden maakt het gedrag
    onafhankelijk van de looptijd van de regelaar.

    ZETTEN doet de regelaar zelf, VLAK VOOR zijn eigen light.turn_on. Die volgorde is
    functioneel: zou hij de vlag erna zetten, dan bestaat er een kort venster waarin zijn
    eigen actie er extern uitziet.

    WISSEN gebeurt hier, en pas als de lamp 10 SECONDEN onafgebroken uit is. Die 10 s is geen
    smaak maar een tegenmaatregel: de Hue-groep meldt zichzelf tijdens een fade van 5 s heel
    even opnieuw als 'on' (waargenomen 08:32:40.711 uit -> 08:32:41.723 aan -> 08:32:55.678
    uit). Zonder de hold zou zo'n artefact de vlag kunnen wissen terwijl de lamp juist
    aanging, en dan zou de regelaar zijn eigen lamp nooit meer mogen uitzetten.
  triggers:
  - trigger: state
    entity_id: light.kantoor
    to: 'off'
    for:
      hours: 0
      minutes: 0
      seconds: 10
    id: lamp_uit
  conditions: []
  actions:
  - if:
    - condition: state
      entity_id: input_boolean.kantoor_lamp_door_automatisering
      state: 'on'
    then:
    - action: input_boolean.turn_on
      target:
        entity_id: input_boolean.kantoor_lamp_handmatig_uit
    - action: input_boolean.turn_off
      target:
        entity_id: input_boolean.kantoor_lamp_door_automatisering
    - action: logbook.log
      data:
        name: Kantoor Adaptief
        message: 'HANDMATIG UIT: de lamp ging uit zonder dat de regelaar dat commandeerde. Niet
          opnieuw aandoen tot het kantoor 10 min leeg is geweest.'
        entity_id: light.kantoor
  mode: single
  max_exceeded: silent
- id: '1734200001009'
  alias: Kantoor Einde Werkdag - Lichten Uit
  description: Zet kantoorverlichting uit wanneer werkstation offline gaat na 17:00 op werkdagen
  triggers:
  - trigger: state
    entity_id: device_tracker.vdhws01
    to: not_home
    for:
      minutes: 5
  conditions:
  - condition: time
    after: '17:00:00'
    weekday:
    - mon
    - tue
    - wed
    - thu
    - fri
  - condition: state
    entity_id: light.kantoor
    state: 'on'
  actions:
  - action: light.turn_off
    target:
      entity_id:
      - light.kantoor
    data:
      transition: 10
  - action: climate.set_hvac_mode
    target:
      entity_id: climate.kantoor
    data:
      hvac_mode: 'off'
  mode: single
- id: '1734200001005'
  alias: Kantoor Notificatie - Deurbel
  description: '⚠ UITGESCHAKELD 2026-08-30 (chg-2026-08-30-005) — werkstation VDHWS01
    is opnieuw geinstalleerd met Linux en heeft geen HA-agent meer. LEES DIT VOOR JE
    HEM WEER AANZET: er zijn TWEE dode afhankelijkheden. (1) De conditie
    device_tracker.vdhws01 == home staat sinds 2026-08-30 21:27 permanent op
    not_home, dus zelfs ingeschakeld zou deze automation nooit vuren. (2) Het
    oorspronkelijke doel notify.vdhws01 bestaat nog wél als service, maar er zit geen
    agent meer achter — bezorging faalt STIL, zonder fout in het log. Het doel is
    daarom omgezet naar notify.persistent_notification, dat altijd aankomt in de
    HA-UI. Kies bij heractivering een echt bureau-doel en herstel of verwijder de
    aanwezigheidsconditie. Origineel: Toon notificatie op werkstation bij deurbel.'
  triggers:
  - trigger: state
    entity_id: binary_sensor.camera_deurbel_deurbel
    to: 'on'
  conditions:
  - condition: state
    entity_id: device_tracker.vdhws01
    state: home
  actions:
  - action: notify.persistent_notification
    data:
      message: Er staat iemand bij de voordeur!
      title: Deurbel
  mode: single
- id: '1734200001006'
  alias: Kantoor Notificatie - Wasmachine Klaar
  description: '⚠ UITGESCHAKELD 2026-08-30 (chg-2026-08-30-005) — werkstation VDHWS01
    is opnieuw geinstalleerd met Linux en heeft geen HA-agent meer. LEES DIT VOOR JE
    HEM WEER AANZET: er zijn TWEE dode afhankelijkheden. (1) De conditie
    device_tracker.vdhws01 == home staat sinds 2026-08-30 21:27 permanent op
    not_home, dus zelfs ingeschakeld zou deze automation nooit vuren. (2) Het
    oorspronkelijke doel notify.vdhws01 bestaat nog wél als service, maar er zit geen
    agent meer achter — bezorging faalt STIL, zonder fout in het log. Het doel is
    daarom omgezet naar notify.persistent_notification, dat altijd aankomt in de
    HA-UI. Kies bij heractivering een echt bureau-doel en herstel of verwijder de
    aanwezigheidsconditie. NB de trigger is `finish` (niet `finished`) — Samsung
    gebruikt voor de wasmachine echt een andere waarde dan voor de droger, dat is
    geen typefout. Origineel: Toon notificatie op werkstation wanneer wasmachine
    klaar is.'
  triggers:
  - trigger: state
    entity_id: sensor.wasmachine_taakstatus
    to: finish
  conditions:
  - condition: state
    entity_id: device_tracker.vdhws01
    state: home
  actions:
  - action: notify.persistent_notification
    data:
      message: De wasmachine is klaar!
      title: Wasmachine
  mode: single
- id: '1734200001007'
  alias: Kantoor Notificatie - Droger Klaar
  description: '⚠ UITGESCHAKELD 2026-08-30 (chg-2026-08-30-005) — werkstation VDHWS01
    is opnieuw geinstalleerd met Linux en heeft geen HA-agent meer. LEES DIT VOOR JE
    HEM WEER AANZET: er zijn TWEE dode afhankelijkheden. (1) De conditie
    device_tracker.vdhws01 == home staat sinds 2026-08-30 21:27 permanent op
    not_home, dus zelfs ingeschakeld zou deze automation nooit vuren. (2) Het
    oorspronkelijke doel notify.vdhws01 bestaat nog wél als service, maar er zit geen
    agent meer achter — bezorging faalt STIL, zonder fout in het log. Het doel is
    daarom omgezet naar notify.persistent_notification, dat altijd aankomt in de
    HA-UI. Kies bij heractivering een echt bureau-doel en herstel of verwijder de
    aanwezigheidsconditie. NB de trigger is `finished` (niet `finish`) — Samsung
    gebruikt voor de droger echt een andere waarde dan voor de wasmachine, dat is
    geen typefout. Origineel: Toon notificatie op werkstation wanneer droger klaar
    is.'
  triggers:
  - trigger: state
    entity_id: sensor.droger_taakstatus
    to: finished
  conditions:
  - condition: state
    entity_id: device_tracker.vdhws01
    state: home
  actions:
  - action: notify.persistent_notification
    data:
      message: De droger is klaar!
      title: Droger
  mode: single
- id: '1734200001008'
  alias: Kantoor Notificatie - Vaatwasser Klaar
  description: '⚠ UITGESCHAKELD 2026-08-30 (chg-2026-08-30-005) — werkstation VDHWS01
    is opnieuw geinstalleerd met Linux en heeft geen HA-agent meer. LEES DIT VOOR JE
    HEM WEER AANZET: er zijn TWEE dode afhankelijkheden. (1) De conditie
    device_tracker.vdhws01 == home staat sinds 2026-08-30 21:27 permanent op
    not_home, dus zelfs ingeschakeld zou deze automation nooit vuren. (2) Het
    oorspronkelijke doel notify.vdhws01 bestaat nog wél als service, maar er zit geen
    agent meer achter — bezorging faalt STIL, zonder fout in het log. Het doel is
    daarom omgezet naar notify.persistent_notification, dat altijd aankomt in de
    HA-UI. Kies bij heractivering een echt bureau-doel en herstel of verwijder de
    aanwezigheidsconditie. Origineel: Toon notificatie op werkstation wanneer
    vaatwasser klaar is.'
  triggers:
  - trigger: state
    entity_id: sensor.vaatwasser_status
    to: finished
  conditions:
  - condition: state
    entity_id: device_tracker.vdhws01
    state: home
  actions:
  - action: notify.persistent_notification
    data:
      message: De vaatwasser is klaar!
      title: Vaatwasser
  mode: single
- id: '1734761531071'
  alias: Kerstverlichting aan en uitzetten
  description: '⚠ UITGESCHAKELD buiten kerstseizoen — entiteiten bestaan alleen als de lampen fysiek aangesloten
    zijn. Re-enable in december en verifieer entity_ids: light.icicle_keuken, light.kerst_ijspegels, light.on_off_plug_1_2
    (deze hadden in 2026-04 hun originele namen). Oorspronkelijke beschrijving: Zet kerstverlichting aan
    om 06:30 en uit om 21:00'
  triggers:
  - trigger: time
    at: 06:30:00
    id: ochtend
  - trigger: time
    at: '21:00:00'
    id: avond
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - ochtend
      sequence:
      - parallel:
        - action: light.turn_on
          target:
            entity_id:
            - light.kerst_ijspegels
            - light.icicle_keuken
            - light.on_off_plug_1_2
          data:
            brightness_pct: 100
        - action: switch.turn_on
          target:
            entity_id:
            - switch.0x7cb03eaa0a0c03a0
            - switch.0xa4c138935509f13a
            - switch.0xa4c138a64565764a
            - switch.0x7cb03eaa0a0c0720
    - conditions:
      - condition: trigger
        id:
        - avond
      sequence:
      - parallel:
        - action: light.turn_off
          target:
            entity_id:
            - light.kerst_ijspegels
            - light.icicle_keuken
            - light.on_off_plug_1_2
        - action: switch.turn_off
          target:
            entity_id:
            - switch.0x7cb03eaa0a0c03a0
            - switch.0xa4c138935509f13a
            - switch.0xa4c138a64565764a
            - switch.0x7cb03eaa0a0c0720
  mode: single
- id: '1736714303570'
  alias: Gangverlichting Brandpad
  description: Schakelt de gangverlichting bij het brandpad in bij bewegingsdetectie wanneer het lichtniveau
    laag is, en schakelt uit na 5 minuten zonder beweging
  triggers:
  - trigger: state
    entity_id:
    - binary_sensor.brandpad_beweging
    from: 'off'
    to: 'on'
  conditions:
  - condition: numeric_state
    entity_id: sensor.brandpad_licht
    attribute: light_level
    # chg-2026-09-09-009: was 55. Hue light_level is a log10 scale
    # (lux = 10**((light_level-1)/10000)), so 55 meant 1.01 LUX - near total darkness.
    # Measured over 1769 samples / 10 days: with 55 the automation armed between 20:43 and
    # 23:46, and on 4 of 10 evenings not until after 22:00 - the path light was dead for the
    # whole evening, not merely late.
    # 16890 = 48.9 lux, derived from the two empirical edges, not picked for roundness:
    #   lowest light_level EVER seen with the sun above 10 deg .. 17866 (61.2 lux)
    #   highest value we must still arm at (evening crossings) .. 15913
    #   light_level is already log-scaled, so the midpoint of [15913,17866] is the
    #   geometric mean in lux -> 16889.5 -> 16890.
    # Validation: 0 of 1351 daylight samples (sun >10 deg) would fire. Arms 19:31-20:36,
    # within ~10 min of sunset, on all 10 evenings.
    # Deliberately NO sun-elevation condition: elevation is a proxy, illuminance is the
    # thing we care about, and gating on elevation would refuse light during a black
    # thunderstorm at 15:00. Elevation was the diagnostic used to size this number.
    # Sensor cadence measured at 5 min (modal gap 299 s), NOT the 15 min previously assumed.
    below: 16890
  actions:
  - action: light.turn_on
    target:
      entity_id: light.brandpad
    data:
      brightness_pct: 100
  - delay:
      hours: 0
      minutes: 5
      seconds: 0
  - action: light.turn_off
    target:
      entity_id: light.brandpad
  mode: restart
- id: '1743483971322'
  alias: Verlichting Schuur
  description: 'Verlichting in de schuur aanzetten bij beweging en laag lichtniveau. Uitzetten wanneer
    er 5 min geen beweging is gedetecteerd.


    LET OP - DRIE IDENTIEK GENAAMDE SENSOREN: er zijn drie Fibaro FGMS-001 multisensoren waarvan de entity-namen
    alleen in de suffix verschillen. De ONGESUFFIXTE entiteiten zijn KANTOOR (device d51c68cc84d57a7924e665c9ab4ff991),
    _2 is SCHUUR (device 7151ae540323f663cce0cb7f4a8f6042) en _3 heeft GEEN area en wordt nergens gebruikt.
    Deze automation hoort overal de _2 entiteiten te gebruiken. Controleer bij elke wijziging via het
    device_registry op area_id - nooit op naam, friendly_name of suffix-gevoel, want alle drie heten gewoon
    Multisensor.


    HISTORIE: tot 2026-09-08 stonden hier op ALLE DRIE de plekken de ongesuffixte kantoor-entiteiten.
    De schuurlamp reageerde daardoor op beweging in het KANTOOR en op de lichtsterkte in het KANTOOR,
    en de 5-minuten uitschakeling wachtte tot het KANTOOR vijf minuten stil was in plaats van de schuur.
    Rechtgezet in chg-2026-09-08-002. De derde plek (de wait_for_trigger) was in de oorspronkelijke melding
    niet opgemerkt.


    DREMPEL: below 100 lux is bewust ONGEWIJZIGD gelaten, maar wel opnieuw getoetst - nu tegen de SCHUUR-sensor
    in plaats van de kantoorsensor. sensor.multisensor_illuminance_2 over 24 h: min 0, mediaan 20, max
    211 lux. De schuur raakt de 100 lux alleen rond het middaghoogtepunt, dus in de praktijk gaat het
    licht bij beweging bijna altijd aan - en dat is voor een bergruimte gewenst. EN 12464-1 rekent 100
    lux voor opslagruimte. Verlaag deze drempel niet: bij bijvoorbeeld 20 lux sta je op een grijze dag
    in het donker terwijl de automation vindt dat het licht genoeg is. Te hoog kost alleen wat licht op
    een 5-minuten timer; te laag is de dure fout.

    '
  triggers:
  - trigger: state
    entity_id:
    - binary_sensor.multisensor_motion_detection_2
    from: 'off'
    to: 'on'
  conditions:
  - condition: numeric_state
    entity_id: sensor.multisensor_illuminance_2
    below: 100
  actions:
  - action: switch.turn_on
    target:
      entity_id: switch.verlichting_schuur
  - wait_for_trigger:
    - entity_id: binary_sensor.multisensor_motion_detection_2
      to: 'off'
      for: 00:05:00
      trigger: state
  - action: switch.turn_off
    target:
      entity_id: switch.verlichting_schuur
  mode: restart
- id: '1743594938098'
  alias: Trapkast licht
  description: Schakelt trapkastverlichting aan bij openen deur, uit bij sluiten (na 15 sec) of na 5 minuten
    automatisch
  triggers:
  - entity_id: binary_sensor.0x54ef441000d51990_contact
    to: 'on'
    trigger: state
    id: trapkast_deur_open
  - entity_id: binary_sensor.0x54ef441000d51990_contact
    to: 'off'
    trigger: state
    id: trapkast_deur_gesloten
  - entity_id:
    - switch.trapkast
    to: 'on'
    for:
      hours: 0
      minutes: 5
      seconds: 0
    trigger: state
    id: trapkast_lamp_aan
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - trapkast_deur_open
      sequence:
      - action: switch.turn_on
        data: {}
        target:
          device_id: a5af9f668a3e5115e41a4e619bbddeb3
    - conditions:
      - condition: trigger
        id:
        - trapkast_deur_gesloten
      sequence:
      - delay:
          hours: 0
          minutes: 0
          seconds: 15
          milliseconds: 0
      - action: switch.turn_off
        data: {}
        target:
          device_id: a5af9f668a3e5115e41a4e619bbddeb3
    - conditions:
      - condition: trigger
        id:
        - trapkast_lamp_aan
      sequence:
      - action: switch.turn_off
        data: {}
        target:
          device_id: a5af9f668a3e5115e41a4e619bbddeb3
  mode: restart
- id: '1747761397947'
  alias: Fontein Uitzetten
  description: Schakelt de tuinfontein elke avond om 21:00 uit om geluidsoverlast te voorkomen en energie
    te besparen
  triggers:
  - trigger: time
    at: '21:00:00'
  conditions: []
  actions:
  - action: switch.turn_off
    target:
      entity_id: switch.0xa4c138a04a98d51e
  mode: single
- id: irrigatie_achtertuin_v2
  alias: Irrigatie Achtertuin
  description: Dagelijks om 06:00 — irrigeer alleen als bodemvocht laag is en er weinig regen verwacht
    wordt. Bodemvocht = mediaan van 3 Tuya bodemsensoren (voor / midden / boom). Drempels en duur via
    input_number helpers. Master-aan via input_boolean.irrigatie_aan.
  triggers:
  - platform: time
    at: 06:00:00
  conditions:
  - condition: state
    entity_id: input_boolean.irrigatie_aan
    state: 'on'
  actions:
  - variables:
      s1_raw: '{{ states(''sensor.0xa4c1385f5913929f_soil_moisture'') }}'
      s2_raw: '{{ states(''sensor.0xa4c138ab28d3ef87_soil_moisture'') }}'
      s3_raw: '{{ states(''sensor.0xa4c13874a5e6db97_soil_moisture'') }}'
      valid: '{{ [s1_raw, s2_raw, s3_raw] | reject(''in'', [''unknown'', ''unavailable'', ''none'']) |
        map(''int'', 0) | list }}'
      moisture: '{% set v = valid | sort %}{% if v|length == 0 %}-1{% elif v|length == 1 %}{{ v[0] }}{%
        elif v|length == 2 %}{{ ((v[0] + v[1]) / 2) | int }}{% else %}{{ v[1] }}{% endif %}'
      threshold: '{{ states(''input_number.irrigatie_drempel'') | int(30) }}'
      rain_skip: '{{ states(''input_number.irrigatie_regen_skip'') | float(3) }}'
      duration: '{{ states(''input_number.irrigatie_duur'') | int(10) }}'
  - if:
    - condition: template
      value_template: '{{ moisture | int < 0 }}'
    then:
    - data:
        title: Irrigatie overgeslagen
        message: Geen bodemsensoren beschikbaar — handmatig controleren.
        notification_id: irrigatie_skip
      action: persistent_notification.create
    - stop: no sensors
  - if:
    - condition: template
      value_template: '{{ moisture | int >= threshold | int }}'
    then:
    - data:
        title: Irrigatie overgeslagen — bodem nat
        message: Bodemvocht {{ moisture }}% ≥ {{ threshold }}%. Niet nodig.
        notification_id: irrigatie_skip
      action: persistent_notification.create
    - stop: soil already wet
  - data:
      type: hourly
    target:
      entity_id: weather.forecast_thuis
    response_variable: forecast_data
    action: weather.get_forecasts
  - variables:
      rain_next_12h: '{{ forecast_data[''weather.forecast_thuis''].forecast[:12] | map(attribute=''precipitation'')
        | select(''number'') | sum | round(1) }}'
  - if:
    - condition: template
      value_template: '{{ rain_next_12h | float >= rain_skip | float }}'
    then:
    - data:
        title: Irrigatie overgeslagen — regen verwacht
        message: 'Verwachte neerslag komende 12u: {{ rain_next_12h }} mm ≥ {{ rain_skip }} mm.'
        notification_id: irrigatie_skip
      action: persistent_notification.create
    - stop: rain forecast
  - target:
      entity_id: switch.diivoo_smart_dual_water_timer_switch_1
    action: switch.turn_on
  - delay:
      minutes: '{{ duration | int }}'
  - target:
      entity_id: switch.diivoo_smart_dual_water_timer_switch_1
    action: switch.turn_off
  - target:
      entity_id: input_datetime.irrigatie_laatste_run
    data:
      datetime: '{{ now().strftime(''%Y-%m-%d %H:%M:%S'') }}'
    action: input_datetime.set_datetime
  - data:
      title: Irrigatie voltooid
      message: '{{ duration }} min gedraaid op switch_1. Bodemvocht was {{ moisture }}%, regenverwachting
        {{ rain_next_12h }} mm.'
      notification_id: irrigatie_done
    action: persistent_notification.create
  mode: single
- id: achtertuin_verlichting
  alias: Achtertuin Verlichting
  description: Aan zodra het lichtniveau achter < 150 lx (2 min sustained) OF 30 min voor zonsondergang.
    Alleen tussen zonsondergang-1u en zonsopgang. Uit om 23:00.
  triggers:
  - trigger: numeric_state
    entity_id: sensor.beweging_sensor_achtertuin_licht
    below: 150
    for:
      minutes: 2
    id: aan
  - trigger: sun
    event: sunset
    offset: -00:30:00
    id: aan
  - trigger: time
    at: '23:00:00'
    id: uit
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id: aan
      - condition: or
        conditions:
        - condition: sun
          after: sunset
          after_offset: -01:00:00
        - condition: sun
          before: sunrise
      sequence:
      - action: light.turn_on
        target:
          entity_id: light.achtertuin
        data:
          brightness_pct: 100
          transition: 30
    - conditions:
      - condition: trigger
        id: uit
      sequence:
      - action: light.turn_off
        target:
          entity_id: light.achtertuin
        data:
          transition: 5
  mode: single
- id: voordeur_licht_detectie
  alias: Voordeur Licht bij Detectie
  description: Persoon gedetecteerd bij de voordeur na zonsondergang -> licht 10 min aan, behalve als
    de voordeur-lamp al aan staat (zodat handmatig licht niet wordt overgenomen). Re-trigger restart de
    10 min.
  triggers:
  - trigger: state
    entity_id:
    - binary_sensor.camera_deurbel_deurbel
    - binary_sensor.camera_deurbel_persoon_gedetecteerd
    - binary_sensor.camera_deurbel_voertuig_gedetecteerd
    - binary_sensor.camera_voorkant_persoon_gedetecteerd
    - binary_sensor.camera_voorkant_voertuig_gedetecteerd
    from: 'off'
    to: 'on'
  conditions:
  - condition: state
    entity_id: sun.sun
    state: below_horizon
  - condition: state
    entity_id: light.voordeur
    state: 'off'
  actions:
  - action: light.turn_on
    target:
      entity_id:
      - light.voordeur
      - light.voordeur_2
    data:
      brightness_pct: 100
  - delay:
      minutes: 10
  - action: light.turn_off
    target:
      entity_id:
      - light.voordeur
      - light.voordeur_2
  mode: restart
- id: voordeur_off_midnight
  alias: Voordeur uit om middernacht
  description: Vangnet om middernacht - als de voordeur-lamp aan staat (bv. handmatig aangezet en vergeten)
    zet hem uit.
  triggers:
  - trigger: time
    at: 00:00:00
  conditions:
  - condition: state
    entity_id: light.voordeur
    state: 'on'
  actions:
  - action: light.turn_off
    target:
      entity_id:
      - light.voordeur
      - light.voordeur_2
  mode: single
- id: alertmanager_critical_notify
  alias: 'Alertmanager: Critical Alert Notification'
  description: Receives critical alerts from Alertmanager via webhook and sends persistent notification
    + mobile push to S25 Ultra Sander
  triggers:
  - trigger: webhook
    webhook_id: alertmanager-critical
    allowed_methods:
    - POST
    local_only: false
  conditions: []
  actions:
  - repeat:
      for_each: '{{ trigger.json.alerts }}'
      sequence:
      - choose:
        - conditions:
          - condition: template
            value_template: '{{ repeat.item.status == ''firing'' }}'
          sequence:
          - action: persistent_notification.create
            data:
              notification_id: am_critical_{{ repeat.item.labels.alertname | slugify }}_{{ repeat.item.labels.instance
                | default('cluster') | slugify }}
              title: 🔥 {{ repeat.item.labels.alertname }}
              message: '**Severity:** {{ repeat.item.labels.severity }}

                **Instance:** {{ repeat.item.labels.instance | default(''cluster'') }}

                **Summary:** {{ repeat.item.annotations.summary | default(''no summary'') }}


                {{ repeat.item.annotations.description | default('''') | truncate(300) }}


                [Alertmanager](http://alertmanager.bluejungle.net) | [Prometheus](http://prometheus.bluejungle.net)'
          - action: notify.mobile_app_galaxy_s25_ultra
            continue_on_error: true
            data:
              title: 🔥 {{ repeat.item.labels.alertname }}
              message: '{{ repeat.item.annotations.summary | default(''Critical alert firing'') }}

                Instance: {{ repeat.item.labels.instance | default(''cluster'') }}'
              data:
                tag: am_critical_{{ repeat.item.labels.alertname | slugify }}
                priority: high
                ttl: 43200
        - conditions:
          - condition: template
            value_template: '{{ repeat.item.status == ''resolved'' }}'
          sequence:
          - action: persistent_notification.dismiss
            data:
              notification_id: am_critical_{{ repeat.item.labels.alertname | slugify }}_{{ repeat.item.labels.instance
                | default('cluster') | slugify }}
          - action: notify.mobile_app_galaxy_s25_ultra
            continue_on_error: true
            data:
              title: '✅ RESOLVED: {{ repeat.item.labels.alertname }}'
              message: '{{ repeat.item.annotations.summary | default(''Alert resolved'') }}

                Instance: {{ repeat.item.labels.instance | default(''cluster'') }}'
              data:
                tag: am_critical_{{ repeat.item.labels.alertname | slugify }}
                priority: default
  mode: queued
  max: 10
- id: '1747224001001'
  alias: Kantoor Aanwezig - Comfort setpoint
  description: 'Zet het kantoorklimaat op de comfort-setpoint zodra
    binary_sensor.kantoor_bezet actief wordt.

    ⚠ WAT DEZE AUTOMATION AANSTUURT: climate.kantoor, een echte split-airco in een
    bewoond huis. Hij past niet alleen setpoints aan maar kan de unit ook AANZETTEN.
    Lees de drempels, de versheidscontrole en het tijdvenster hieronder voor je iets
    wijzigt.

    TRIGGER: binary_sensor.kantoor_bezet naar ''on''. Dat is een template-sensor in
    configuration.yaml met debounce 45 s AAN / 15 min UIT - de debounce zit daar, niet
    in deze automation. Bron is de Z-Wave PIR van het kantoor,
    binary_sensor.multisensor_motion_detection. LET OP: de ongesuffixte entiteit is
    Kantoor, _2 = Schuur en _3 = geen area.

    STAAT DE UNIT AL AAN: alleen de setpoint wordt bijgesteld en de ACTIEVE hvac_mode
    blijft behouden - heat -> 20 degC, cool -> 21 degC. auto/dry/fan_only/heat_cool
    worden met rust gelaten. Deze twee branches hebben GEEN tijdvenster.

    STAAT DE UNIT UIT: de modus wordt afgeleid uit sensor.kantoor_temperatuur -
    < 18 degC verwarmen naar 20 degC, >= 23,5 degC koelen naar 21 degC, en daartussen
    bewust NIETS aanzetten. Deze twee AANZET-branches werken ALLEEN tussen 08:00 en
    18:00; buiten dat venster zet deze automation de airco dus nooit aan. Reden: de
    tegenhanger 1747987200001 zet de airco alle zeven dagen om 18:00 uit, en Afwezig
    (1747224001002) zet bewust NOOIT hvac_mode off (chg-2026-08-30-004). Zonder deze
    poort zou een latch om bijvoorbeeld 20:00 een split-unit de hele nacht in cool
    laten draaien. Een open raam wint altijd.

    ⚠ chg-2026-09-07-001 - WAAROM EERST EEN REFRESH EN DAN PAS EEN BESLUIT:
    sensor.kantoor_temperatuur is geen ruisende sensor maar een Tado-cloudwaarde die
    HA eens per 30 minuten ophaalt (n=466 over 10 dagen, p50 interval 1801 s). De
    meting achter de HA-state is mediaan 38,8 min oud, p90 48,6 min. Op 2026-09-04
    om 07:37:53Z zag deze automation 23,02 (door Tado gemeten om 07:05:51Z, dus 32
    minuten oud) terwijl Tado zelf al 22,79 klaar had staan (gemeten om 07:31:57Z).
    Die ene muffe waarde zette de airco 8 uur 22 min aan. Een `for:`-dwell lost dit
    NIET op: de drempel was 28 minuten aaneengesloten waar. Daarom nu, in volgorde:
    (1) `homeassistant.update_entity` haalt eerst een VERSE meting op bij Tado en
    ververst tegelijk climate.kantoor, want `hvac == off` is even muf en even
    zwaarwegend - gemeten 1,07 s, en het brengt de meetleeftijd terug naar mediaan
    8,3 min; (2) `meting_vers` is een DODE-FEED-DETECTOR, geen versheidseis: hij
    blokkeert pas als Tado al 2 uur niets meer gepubliceerd heeft. 2 uur en niet 30 min,
    omdat Tado zelf maar eens per ~33 min publiceert (p50 33,6 / p90 39,6 / max 91,8 min
    over 5 dagen); een drempel van 30 min zou door de inspection-paradox 18% van alle
    GEZONDE beslissingen blokkeren. Bij 2 uur is dat 0% op gemeten data. Het VERSEN doet
    update_entity, niet deze check. Dit is het vangnet voor `continue_on_error: true` -
    zonder die check zou een mislukte refresh stilletjes terugvallen op het oude gedrag,
    want een mislukte coordinator-refresh gooit GEEN fout maar zet alleen
    last_update_success op false, dus het is anders fail-OPEN. De vorm
    `as_timestamp(..., 0)` maakt een ontbrekend of kapot attribuut FAIL-CLOSED;
    (3) de koeldrempel kreeg een
    dodeband van 0,5 degC (23,0 -> 23,5), afgeleid uit de gemeten drift van p99 0,49
    degC per 30 minuten. Op 10 dagen echte data levert dat 3 koeldagen op in plaats
    van 7: eruit vallen precies de randgevallen (dagmaxima 23,21 / 23,06 / 23,02 /
    23,46), erin blijven de echt warme dagen (25,31 / 24,42 / 23,85). De VERWARM-drempel
    blijft bewust op <18 degC en krijgt alleen de versheidscontrole - zie
    1734200001001 voor de onderbouwing. De twee BIJSTEL-branches raken geen
    hvac_mode aan en hebben de dodeband dus niet nodig.

    ⚠ GEKOPPELD AAN 1734200001001 (Kantoor Ochtend - Klimaat): de comfort-setpoints
    heat 20 / cool 21, de koeldrempel >= 23,5 degC en de versheidscontrole zijn exact
    gelijk aan die van de ochtendroutine, zodat de eerste aanwezigheids-latch de
    routine van 08:30 niet overschrijft maar bevestigt. Wijzig deze waarden nooit los
    van 1734200001001.

    HISTORIE: tot 2026-08-30 was deze automation dormant, omdat
    binary_sensor.kantoor_bezet een stub was (letterlijke placeholder FP2_ID; de
    kantoor-FP2 is nooit gekoppeld). chg-2026-08-30-005 heeft hem live gezet en in
    ronde 2 de debounce, de setpoints, de koeldrempel en het tijdvenster bijgesteld.
    De vervangen waarden staan in dat change-record, niet hier - deze omschrijving
    beschrijft uitsluitend de HUIDIGE werking.

    '
  triggers:
  - trigger: state
    entity_id: binary_sensor.kantoor_bezet
    to: 'on'
  conditions:
  - condition: state
    entity_id: binary_sensor.kantoor_raam
    state: 'off'
  actions:
  - action: homeassistant.update_entity
    continue_on_error: true
    target:
      entity_id:
      - sensor.kantoor_temperatuur
      - climate.kantoor
  - variables:
      hvac: "{{ states('climate.kantoor') }}"
      kamer_temp: "{{ states('sensor.kantoor_temperatuur') | float(-99) }}"
      meting_vers: "{{ (as_timestamp(now()) - as_timestamp(state_attr('sensor.kantoor_temperatuur', 'time'), 0)) < 7200 }}"
  - choose:
    - conditions:
      - condition: template
        value_template: "{{ hvac == 'heat' }}"
      sequence:
      - action: climate.set_temperature
        target:
          entity_id: climate.kantoor
        data:
          temperature: 20
    - conditions:
      - condition: template
        value_template: "{{ hvac == 'cool' }}"
      sequence:
      - action: climate.set_temperature
        target:
          entity_id: climate.kantoor
        data:
          temperature: 21
    - conditions:
      - condition: template
        value_template: "{{ hvac == 'off' and (meting_vers | bool(false)) and (kamer_temp | float(-99)) > -99 and (kamer_temp | float(-99)) < 18 }}"
      - condition: time
        after: 08:00:00
        before: '18:00:00'
      sequence:
      - action: climate.set_hvac_mode
        target:
          entity_id: climate.kantoor
        data:
          hvac_mode: heat
      - action: climate.set_temperature
        target:
          entity_id: climate.kantoor
        data:
          temperature: 20
      - action: climate.set_swing_mode
        target:
          entity_id: climate.kantoor
        data:
          swing_mode: both
    - conditions:
      - condition: template
        value_template: "{{ hvac == 'off' and (meting_vers | bool(false)) and (kamer_temp | float(-99)) >= 23.5 }}"
      - condition: time
        after: 08:00:00
        before: '18:00:00'
      sequence:
      - action: climate.set_hvac_mode
        target:
          entity_id: climate.kantoor
        data:
          hvac_mode: cool
      - action: climate.set_temperature
        target:
          entity_id: climate.kantoor
        data:
          temperature: 21
      - action: climate.set_swing_mode
        target:
          entity_id: climate.kantoor
        data:
          swing_mode: both
  mode: single
- id: '1747224001002'
  alias: Kantoor Afwezig - Setback
  description: 'Zet het kantoorklimaat terug zodra binary_sensor.kantoor_bezet inactief
    wordt. De 15-min OFF-debounce zit in de template binary sensor, niet hier, zodat
    korte pauzes (toilet, koffie) niets verstoren.

    De trigger eist expliciet from: "on". Zonder dat zou een template-herrendering
    (unknown -> off) de setback laten vuren terwijl er nooit iemand weg is gegaan:
    een eenrichtings-ratel die alleen comfort omlaag kan bijstellen. Aanwezig
    (to: "on") heeft dat probleem niet, dus dit maakt de twee helften symmetrisch.

    Behoudt de ACTIEVE hvac_mode en wijzigt alleen de setpoint: heat -> 18 degC,
    cool -> 26 degC. 18 degC is het device-minimum (climate.kantoor min_temp = 18.0);
    de oorspronkelijke 17 degC werd door het device geweigerd. Thermisch is dat verschil
    verwaarloosbaar: bij 18 degC in heat staat de compressor stil. Bewust GEEN
    hvac_mode off, want dan verliest de unit zijn modus en komt koeling op een milde
    dag niet terug. Staat de unit al uit, dan gebeurt er niets. Een open raam wint altijd.

    LIVE sinds 2026-08-30 (chg-2026-08-30-005). binary_sensor.kantoor_bezet was tot
    dan een STUB (letterlijke placeholder FP2_ID; de kantoor-FP2 is nooit gekoppeld)
    en kon alleen ''off'' zijn, dus deze automation vuurde nooit. De bron is nu de
    Z-Wave PIR van het kantoor, binary_sensor.multisensor_motion_detection - de
    ongesuffixte entiteit is Kantoor, _2 = Schuur en _3 = geen area. De 15-minuten
    OFF-debounce zit in die template binary sensor en is bewust lang: hij overbrugt
    de gaten terwijl je stil aan je bureau zit. Niet verkorten.

    Deze automation zet nog steeds NOOIT hvac_mode off - dat is opzet. Het nachtelijke
    gat dat daardoor ontstond is aan de andere kant dichtgezet: 1747987200001 zet de
    airco nu ALLE DAGEN om 18:00 uit, en de aanzet-branches van Aanwezig
    (1747224001001) staan alleen tussen 08:00 en 18:00.

    '
  triggers:
  - trigger: state
    entity_id: binary_sensor.kantoor_bezet
    from: 'on'
    to: 'off'
  conditions:
  - condition: state
    entity_id: binary_sensor.kantoor_raam
    state: 'off'
  actions:
  - variables:
      hvac: "{{ states('climate.kantoor') }}"
      kamer_temp: "{{ states('sensor.kantoor_temperatuur') | float(-99) }}"
  - choose:
    - conditions:
      - condition: template
        value_template: "{{ hvac == 'heat' }}"
      sequence:
      - action: climate.set_temperature
        target:
          entity_id: climate.kantoor
        data:
          temperature: 18
    - conditions:
      - condition: template
        value_template: "{{ hvac == 'cool' }}"
      sequence:
      - action: climate.set_temperature
        target:
          entity_id: climate.kantoor
        data:
          temperature: 26
  mode: single
- id: '1756580000001'
  alias: Kantoor Raam Open - Klimaat Uit
  description: 'Zet climate.kantoor uit als binary_sensor.kantoor_raam langer dan 2
    minuten open staat. De toestand vlak voor het openen wordt eerst in een snapshot-scene
    bewaard zodat Kantoor Raam Dicht hem exact kan herstellen (modus, setpoint, fan,
    swing, preset).

    Er wordt ALTIJD een snapshot gemaakt, ook als de unit al uit stond - anders zou
    een oude scene blijven staan en bij het sluiten een verouderde toestand terugzetten.

    Let op: binary_sensor.kantoor_raam is Tado Open Window Detection (algoritmisch,
    geen fysiek raamcontact) en detecteert alleen als de zone actief is.

    '
  triggers:
  - trigger: state
    entity_id: binary_sensor.kantoor_raam
    to: 'on'
    for:
      minutes: 2
  conditions: []
  actions:
  - action: scene.create
    data:
      scene_id: kantoor_klimaat_voor_raam
      snapshot_entities:
      - climate.kantoor
  - if:
    - condition: not
      conditions:
      - condition: state
        entity_id: climate.kantoor
        state: 'off'
    then:
    - action: climate.set_hvac_mode
      target:
        entity_id: climate.kantoor
      data:
        hvac_mode: 'off'
  mode: single
- id: '1756580000002'
  alias: Kantoor Raam Dicht - Klimaat Herstellen
  description: 'Herstelt climate.kantoor naar de toestand van vlak voor het openen van
    het raam. Doet niets als de snapshot-scene niet bestaat - scenes uit scene.create
    overleven een HA-herstart niet, en dan is "uit laten staan" de veilige uitkomst.

    De trigger eist expliciet from: "on". binary_sensor.kantoor_raam doorloopt
    aantoonbaar off -> unknown -> off ongeveer elke 36 uur (4x in 7 dagen, gemeten
    2026-08-30). Zonder from: "on" vuurt elk van die herrenderingen deze automation.
    Vandaag onschadelijk omdat clausule 1 hem tegenhoudt, maar bij een Tado
    config-entry reload terwijl het raam echt open staat is de snapshot vers en
    passeren alle clausules - dan gaat de airco weer aan met het raam open.

    De guard doet twee dingen. (1) "states.scene.X is not none" en NIET states("scene.X"):
    een vers aangemaakte scene die nog nooit geactiveerd is heeft state "unknown",
    precies dezelfde waarde die een NIET-bestaande entiteit teruggeeft; alleen de
    object-vorm onderscheidt die twee. (2) De last_triggered-vergelijking eist dat
    "Raam Open" NA de vorige herstelactie heeft gedraaid. Zonder die eis zou een raam
    dat korter dan 2 minuten open staat (Raam Open vuurt dan niet, er is dus geen
    verse snapshot) bij het sluiten een VEROUDERDE scene terugzetten en de airco
    spontaan aanzetten. Beide geverifieerd op 2026-08-30.

    '
  triggers:
  - trigger: state
    entity_id: binary_sensor.kantoor_raam
    from: 'on'
    to: 'off'
  conditions:
  - condition: template
    value_template: >-
      {{ states.scene.kantoor_klimaat_voor_raam is not none
         and state_attr('automation.kantoor_raam_open_klimaat_uit', 'last_triggered') is not none
         and (state_attr('automation.kantoor_raam_dicht_klimaat_herstellen', 'last_triggered') is none
              or state_attr('automation.kantoor_raam_open_klimaat_uit', 'last_triggered')
                 > state_attr('automation.kantoor_raam_dicht_klimaat_herstellen', 'last_triggered')) }}
  actions:
  - action: scene.turn_on
    target:
      entity_id: scene.kantoor_klimaat_voor_raam
  mode: single
- id: '1749566000001'
  alias: Outdoor Power-Blip Logger (observe-only)
  description: 'Durably logs outdoor Hue light power-blips, covering BOTH known variants: (1) a member
    becoming ''on'' shortly after ''unavailable'' (classic power-restore, any hour), and (2) any member
    turning ''on'' during the overnight window 00:30-05:30 local, when there is no legitimate dusk (dusk
    ~21:00) or manual activation - this catches the flicker-burst variant that records no ''unavailable''
    state. Observe-only: never turns any light on or off. Writes to counter.outdoor_blip_count, input_datetime.outdoor_blip_last
    and input_text.outdoor_blip_log so the record survives the recorder purge and HA restarts. Normal
    ~21:00 dusk activation is a clean off->on outside the overnight window and does NOT match.'
  triggers:
  - trigger: state
    id: unavail
    entity_id:
    - light.lichtzuil_linksvoor
    - light.lichtzuil_rechtsvoor
    - light.schutting_voor
    - light.schutting_achter
    - light.spot_boom_linksachter
    - light.spot_boom_rechtsachter
    - light.lichtstrip_tuinhuis_links
    - light.lamp_buitenkeuken
    from: unavailable
    to: 'on'
  - trigger: state
    id: overnight
    entity_id:
    - light.lichtzuil_linksvoor
    - light.lichtzuil_rechtsvoor
    - light.schutting_voor
    - light.schutting_achter
    - light.spot_boom_linksachter
    - light.spot_boom_rechtsachter
    - light.lichtstrip_tuinhuis_links
    - light.lamp_buitenkeuken
    to: 'on'
  conditions:
  - condition: template
    value_template: '{% if trigger.id == ''unavail'' %}true{% else %}{% set t = now().strftime(''%H:%M'')
      %}{{ (t >= ''00:30'') and (t <= ''05:30'') }}{% endif %}'
  actions:
  - action: counter.increment
    target:
      entity_id: counter.outdoor_blip_count
  - action: input_datetime.set_datetime
    target:
      entity_id: input_datetime.outdoor_blip_last
    data:
      datetime: '{{ now().strftime("%Y-%m-%d %H:%M:%S") }}'
  - variables:
      which: '{{ trigger.to_state.name if (trigger is defined and trigger.to_state is defined and trigger.to_state)
        else ''outdoor light'' }}'
      kind: '{% if trigger is defined and trigger.id == ''unavail'' %}power-restore{% elif trigger is
        defined and trigger.id == ''overnight'' %}overnight-on{% else %}manual{% endif %}'
      entry: '{{ now().strftime("%Y-%m-%d %H:%M") }} ({{ which }}, {{ kind }})'
      prev: '{% set p = states("input_text.outdoor_blip_log") %}{{ "" if p in ["unknown", "unavailable",
        "none", ""] else p }}'
      combined: '{{ (entry ~ (" | " ~ prev if prev else "")) }}'
  - action: input_text.set_value
    target:
      entity_id: input_text.outdoor_blip_log
    data:
      value: '{{ combined[:255] }}'
  - action: persistent_notification.create
    data:
      notification_id: outdoor_blip_{{ now().strftime('%Y%m%d_%H%M%S') }}
      title: Outdoor lights powered on unexpectedly
      message: 'Outdoor lights powered on unexpectedly at {{ now().strftime(''%H:%M:%S on %d-%m-%Y'')
        }} (triggered by {{ trigger.to_state.name if (trigger is defined and trigger.to_state is defined
        and trigger.to_state) else ''outdoor light'' }}) - blip #{{ states(''counter.outdoor_blip_count'')
        }}. {% if trigger is defined and trigger.id == ''unavail'' %}This matches a power-restore signature
        (light came on shortly after being unavailable).{% elif trigger is defined and trigger.id == ''overnight''
        %}This was a spontaneous overnight on (00:30-05:30) with no dusk or manual cause - matches the
        flicker-burst power-blip signature.{% else %}Logged by the outdoor power-blip logger.{% endif
        %}'
  - action: notify.send_message
    continue_on_error: true
    target:
      entity_id: notify.s25_ultra_sander
    data:
      title: Outdoor power-blip detected
      message: 'Outdoor lights powered on unexpectedly at {{ now().strftime(''%H:%M:%S'') }} - blip #{{
        states(''counter.outdoor_blip_count'') }} ({% if trigger is defined and trigger.id == ''overnight''
        %}overnight-on{% else %}power-restore{% endif %}).'
  - delay:
      seconds: 90
  mode: single
  max_exceeded: silent
- id: homewizard_sockets_30s_poll
  alias: HomeWizard Energy Sockets 30s poll
  description: Auto-polling is disabled on the 25 HomeWizard Energy Socket config entries (coordinator
    default 5s) to cut 2.4GHz airtime. This refreshes one entity per socket coordinator every 30s, which
    triggers a full device refresh. Leaves P1/kWh/Watermeter on their own polling.
  triggers:
  - trigger: time_pattern
    seconds: /30
  conditions: []
  actions:
  - action: homeassistant.update_entity
    data:
      entity_id:
      - sensor.energy_socket_power
      - sensor.energy_socket_power_10
      - sensor.energy_socket_power_11
      - sensor.energy_socket_power_12
      - sensor.energy_socket_power_13
      - sensor.energy_socket_power_14
      - sensor.energy_socket_power_15
      - sensor.energy_socket_power_16
      - sensor.energy_socket_power_17
      - sensor.energy_socket_power_18
      - sensor.energy_socket_power_19
      - sensor.energy_socket_power_2
      - sensor.energy_socket_power_20
      - sensor.energy_socket_power_21
      - sensor.energy_socket_power_22
      - sensor.energy_socket_power_23
      - sensor.energy_socket_power_24
      - sensor.energy_socket_power_25
      - sensor.energy_socket_power_3
      - sensor.energy_socket_power_4
      - sensor.energy_socket_power_5
      - sensor.energy_socket_power_6
      - sensor.energy_socket_power_7
      - sensor.energy_socket_power_8
      - sensor.energy_socket_power_9
  mode: single
  max_exceeded: silent
- id: '1784538201197'
  alias: Tuin Fontein Aan bij Muziek
  description: Zet de tuinfontein aan zodra een van de tuinspeakers muziek speelt, tussen 09:00 en 21:00.
    Uitzetten gebeurt uitsluitend door de bestaande automatisering Fontein Uitzetten om 21:00.
  triggers:
  - trigger: state
    entity_id:
    - media_player.terras
    - media_player.terras_2
    - media_player.achtertuin
    - media_player.achtertuin_2
    - media_player.eetkamer
    - media_player.eetkamer_2
    - media_player.bar_unnamed_room
    - media_player.bar_unnamed_room_2
    to: playing
  conditions:
  - condition: time
    after: 09:00:00
    before: '21:00:00'
  actions:
  - action: switch.turn_on
    target:
      entity_id: switch.0xa4c138a04a98d51e
  mode: single
- id: '1753005600006'
  alias: Adaptieve Verlichting Begane Grond
  description: 'Avond-adaptief: 1u voor zonsondergang t/m 23:00 gaat de begane grond (keuken+woonkamer,
    8 lampen) EENMAAL per avond aan bij donker (<40 lux) + aanwezigheid (FP2 zone 3), helderheid geschaald
    op lux (Cozy 20-70%, feller=donkerder). GEEN auto-uit, GEEN her-dim: handmatig aan/uit voor 23:00
    wordt nooit overschreven. Latch input_boolean.adaptief_bg_vanavond_gedaan wordt bij window-start (zonsondergang-1u)
    opnieuw gewapend en na inschakelen gezet -> max 1x per avond en ''handmatig uit blijft uit''. Nachtelijke
    uit staat in aparte automation ''Woonlaag - Nachtelijke uit''.'
  triggers:
  - id: window_start
    trigger: sun
    event: sunset
    offset: -01:00:00
  - id: lux_dark
    trigger: numeric_state
    entity_id: sensor.presence_sensor_fp2_f08e_light_sensor_light_level
    below: 40
    for:
      minutes: 2
  - id: presence
    trigger: state
    entity_id: binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3
    to: 'on'
    from: 'off'
  conditions:
  - alias: Alleen middag/avond (geen na-middernacht venster)
    condition: time
    after: '12:00:00'
    before: '23:00:00'
  - alias: Na zonsondergang-1u
    condition: sun
    after: sunset
    after_offset: -01:00:00
  - alias: Lux geldig (fail-safe)
    condition: template
    value_template: '{{ has_value(''sensor.presence_sensor_fp2_f08e_light_sensor_light_level'') and states(''sensor.presence_sensor_fp2_f08e_light_sensor_light_level'')|float(-1)
      >= 0 }}'
  actions:
  - alias: 'Bij window-start: latch opnieuw wapenen'
    if:
    - condition: template
      value_template: '{{ trigger.id == ''window_start'' }}'
    then:
    - action: input_boolean.turn_off
      target:
        entity_id: input_boolean.adaptief_bg_vanavond_gedaan
  - alias: Eenmaal per avond aan bij donker + aanwezig
    if:
    - condition: state
      entity_id: input_boolean.adaptief_bg_vanavond_gedaan
      state: 'off'
    - condition: numeric_state
      entity_id: sensor.presence_sensor_fp2_f08e_light_sensor_light_level
      below: 40
    - condition: state
      entity_id: binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3
      state: 'on'
    then:
    - alias: Keuken (FP2-lux)
      action: light.turn_on
      target:
        entity_id:
        - light.ledstrip_keukenkastjes
        - light.lightstrip_koof
        - light.verlichting_aanrecht
        - light.verlichting_eettafel
        - light.keuken
      data:
        transition: 2
        brightness_pct: '{% set L = states(''sensor.presence_sensor_fp2_f08e_light_sensor_light_level'')|float(-1)
          %}{% set b = (20 + 50*((40 - L)/35))|round(0) %}{{ [70,[20,b]|max]|min }}'
    - alias: Woonkamer (FP300-lux, FP2-fallback)
      action: light.turn_on
      target:
        entity_id:
        - light.woonkamer
        - light.woonkamer_lamp
        - light.woonkamer_lamp_2
      data:
        transition: 2
        brightness_pct: '{% set fp = states(''sensor.presence_woonkamer_illuminance'')|float(-1) %}{%
          set age = (now() - states.sensor.presence_woonkamer_illuminance.last_updated).total_seconds()
          if has_value(''sensor.presence_woonkamer_illuminance'') else 99999 %}{% set fp2 = states(''sensor.presence_sensor_fp2_f08e_light_sensor_light_level'')|float(-1)
          %}{% set L = fp if (fp >= 0 and age < 3600) else fp2 %}{% set b = (20 + 50*((40 - L)/35))|round(0)
          %}{{ [70,[20,b]|max]|min }}'
    - action: input_boolean.turn_on
      target:
        entity_id: input_boolean.adaptief_bg_vanavond_gedaan
  mode: restart
- id: '1753005600008'
  alias: Woonlaag - Nachtelijke uit
  description: 'Na 23:00 (t/m 06:00): begane grond (10 lampen: keuken+woonkamer+bar) gaat UIT zodra ALLE
    activiteit weg is - geen aanwezigheid keuken (FP2 zone 3), TV uit (tv_woonkamer_2 niet on/playing),
    geen Sonos playing in woonkamer/platenspeler/keuken/bar. Uit 15 min nadat alles stil is (template-trigger
    for:15min), of om 23:00 als het dan al stil is, of 15 min nadat een lamp aangaat terwijl alles stil
    is. woonkamer_lamp blijft 10 min courtesy en gaat dan uit. Vervangt het oude handmatige-off-getriggerde
    ''Laatste licht uit''. mode restart. Voor 23:00 raakt deze automation niets aan.'
  triggers:
  - id: all_clear_15m
    trigger: template
    value_template: '{{ is_state(''binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3'',''off'')
      and states(''media_player.tv_woonkamer_2'') not in [''on'',''playing''] and states(''media_player.woonkamer'')
      != ''playing'' and states(''media_player.woonkamer_platenspeler'') != ''playing'' and states(''media_player.keuken'')
      != ''playing'' and states(''media_player.bar_2'') != ''playing'' and is_state(''binary_sensor.presence_woonkamer'',''off'')
      }}'
    for:
      minutes: 15
  - id: at_2300
    trigger: time
    at: '23:00:00'
  - id: light_on_quiet
    trigger: state
    entity_id:
    - light.woonkamer
    - light.woonkamer_lamp
    - light.woonkamer_lamp_2
    - light.keuken
    - light.lightstrip_koof
    - light.ledstrip_keukenkastjes
    - light.verlichting_aanrecht
    - light.verlichting_eettafel
    - light.bartafel
    - light.bartafel_grond
    to: 'on'
    for:
      minutes: 15
  conditions:
  - alias: Alleen 23:00-05:30
    condition: time
    after: '23:00:00'
    before: 05:30:00
  - alias: Alle activiteit weg
    condition: template
    value_template: '{{ is_state(''binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3'',''off'')
      and states(''media_player.tv_woonkamer_2'') not in [''on'',''playing''] and states(''media_player.woonkamer'')
      != ''playing'' and states(''media_player.woonkamer_platenspeler'') != ''playing'' and states(''media_player.keuken'')
      != ''playing'' and states(''media_player.bar_2'') != ''playing'' and is_state(''binary_sensor.presence_woonkamer'',''off'')
      }}'
  - alias: Minstens 1 doellamp aan
    condition: template
    value_template: '{{ expand(''light.woonkamer'',''light.woonkamer_lamp'',''light.woonkamer_lamp_2'',''light.keuken'',''light.lightstrip_koof'',''light.ledstrip_keukenkastjes'',''light.verlichting_aanrecht'',''light.verlichting_eettafel'',''light.bartafel'',''light.bartafel_grond'')
      | selectattr(''state'',''eq'',''on'') | list | count > 0 }}'
  actions:
  - alias: Veeg 9 lampen (behalve woonkamer_lamp)
    action: light.turn_off
    target:
      entity_id:
      - light.woonkamer
      - light.woonkamer_lamp_2
      - light.keuken
      - light.lightstrip_koof
      - light.ledstrip_keukenkastjes
      - light.verlichting_aanrecht
      - light.verlichting_eettafel
      - light.bartafel
      - light.bartafel_grond
  - alias: 'Courtesy: woonkamer_lamp nog 10 min'
    delay:
      minutes: 10
  - alias: woonkamer_lamp uit (idempotent)
    action: light.turn_off
    target:
      entity_id: light.woonkamer_lamp
  mode: restart
- id: '1753268400001'
  alias: FP2 Keuken - Offline detectie
  description: Notify-only wedge detector for the kitchen Aqara FP2 (chg-2026-07-23-005). A1 = unavailable
    30 min continuously. A2 = >75 min cumulative unavailability in a rolling 4 h while currently down
    >=10 min. One notification per DISTINCT outage episode, minimum 60 min between notifications. There
    is deliberately NO recovery action - no smart plug exists. See docs/design/fp2-watchdog.md.
  triggers:
  - trigger: state
    entity_id: binary_sensor.presence_sensor_fp2_f08e_presence_sensor_1
    to: unavailable
    for: 00:30:00
    id: A1
  - trigger: numeric_state
    entity_id: sensor.fp2_keuken_offline_4u
    above: 1.25
    id: A2
  conditions:
  - alias: FP2 must actually be down right now
    condition: template
    value_template: '{{ is_state(''binary_sensor.presence_sensor_fp2_f08e_presence_sensor_1'',''unavailable'')
      }}'
  - alias: A2 dwell - down for at least 10 minutes
    condition: template
    value_template: '{% set t = trigger | default({}, true) %}{% set tid = t.id | default('''') %}{{ tid
      == ''A1'' or (now() - states.binary_sensor.presence_sensor_fp2_f08e_presence_sensor_1.last_changed).total_seconds()
      >= 600 }}'
  - alias: distinct episode + 60 min minimum re-notify interval
    condition: template
    value_template: '{% set lt = state_attr(''automation.fp2_keuken_offline_detectie'',''last_triggered'')
      %}{% set ep = states.binary_sensor.presence_sensor_fp2_f08e_presence_sensor_1.last_changed %}{{
      lt is none or (lt < ep and (now() - lt).total_seconds() >= 3600) }}'
  actions:
  - variables:
      down_min: '{{ ((now() - states.binary_sensor.presence_sensor_fp2_f08e_presence_sensor_1.last_changed).total_seconds()
        / 60) | round(0) | int }}'
      reden: '{% set t = trigger | default({}, true) %}{% set tid = t.id | default('''') %}{% if tid ==
        ''A1'' %}A1 - 30 min onafgebroken offline{% else %}A2 - {{ (states(''sensor.fp2_keuken_offline_4u'')
        | float(0) * 60) | round(0) | int }} min offline in de laatste 4 uur{% endif %}'
      bericht: 'FP2 keuken is offline. Trigger: {{ reden }}. Nu {{ down_min }} min onbereikbaar. Offline
        in de laatste 24 u: {{ states(''sensor.fp2_keuken_offline_24u'') | float(0) | round(1) }} u. Er
        is geen automatisch herstel - power-cycle de USB-voeding handmatig als dit aanhoudt.'
  - action: persistent_notification.create
    data:
      notification_id: fp2_keuken_offline
      title: FP2 keuken offline
      message: '{{ bericht }}'
  - action: notify.mobile_app_galaxy_s25_ultra
    continue_on_error: true
    data:
      title: FP2 keuken offline
      message: '{{ bericht }}'
  mode: single
  max_exceeded: silent
- id: '1753268400002'
  alias: FP2 Keuken - Weer online
  description: Recovery notification for the kitchen Aqara FP2 (chg-2026-07-23-005). Only fires when the
    offline detector actually notified during the outage that just ended, so a short blip never produces
    a lone "recovered" message. The user is explicitly monitoring whether the FP2 recovers on its own.
  triggers:
  - trigger: state
    entity_id: binary_sensor.presence_sensor_fp2_f08e_presence_sensor_1
    from: unavailable
  conditions:
  - alias: recovered to a real state, not unknown
    condition: template
    value_template: '{% set t = trigger | default({}, true) %}{% set ts = t.to_state | default(none, true)
      %}{{ ts is not none and ts.state in [''on'',''off''] }}'
  - alias: a detection notification was sent during this same outage
    condition: template
    value_template: '{% set lt = state_attr(''automation.fp2_keuken_offline_detectie'',''last_triggered'')
      %}{% set t = trigger | default({}, true) %}{% set fs = t.from_state | default(none, true) %}{{ lt
      is not none and fs is not none and lt >= fs.last_changed }}'
  actions:
  - variables:
      duur_min: '{% set t = trigger | default({}, true) %}{% set ts = t.to_state | default(none, true)
        %}{% set fs = t.from_state | default(none, true) %}{{ ((ts.last_changed - fs.last_changed).total_seconds()
        / 60) | round(0) | int if ts and fs else 0 }}'
  - action: persistent_notification.dismiss
    data:
      notification_id: fp2_keuken_offline
  - action: notify.mobile_app_galaxy_s25_ultra
    continue_on_error: true
    data:
      title: FP2 keuken weer online
      message: 'FP2 keuken is uit zichzelf hersteld na {{ duur_min }} min offline. Offline in de laatste
        24 u: {{ states(''sensor.fp2_keuken_offline_24u'') | float(0) | round(1) }} u.'
  mode: single
  max_exceeded: silent
- id: notify_path_canary
  alias: 'Canary: critical notify-path heartbeat'
  description: 'Weekly heartbeat pushing a test notification through the SAME notify service the Alertmanager
    critical path uses (notify.mobile_app_galaxy_s25_ultra), keeping notify.s25_ultra_sander last-sent
    fresh during quiet periods. Dead-path DETECTION is done by the decoupled notify_path_watchdog (reads
    timestamp only, never calls notify) because continue_on_error does NOT catch ServiceNotFound on a
    renamed service - an inline detector could be aborted by the very failure it must report. Manual run:
    fire event notify_canary_run. Ref chg-2026-07-24-001 / inc-2026-07-23-001.'
  triggers:
  - trigger: time
    at: 09:00:00
    id: sched
  - trigger: event
    event_type: notify_canary_run
    id: manual
  conditions:
  - condition: template
    value_template: '{{ trigger is none or trigger.id == ''manual'' or now().weekday() == 0 }}'
  actions:
  - action: notify.mobile_app_galaxy_s25_ultra
    continue_on_error: true
    data:
      title: Notify-path canary
      message: Weekly critical-notify path check {{ now().strftime('%Y-%m-%d %H:%M') }}
      data:
        tag: notify_canary
        priority: high
        ttl: 3600
  mode: single
- id: notify_path_watchdog
  alias: 'Canary: notify-path staleness watchdog'
  description: 'Daily DECOUPLED detector for a dead critical-notify path. Reads ONLY notify.s25_ultra_sander
    last-sent (never calls notify, so a ServiceNotFound on a renamed service cannot abort it). If nothing
    reached the phone in > 8 days (the weekly canary guarantees a heartbeat when healthy) it raises an
    in-HA persistent_notification + logbook entry and sets input_boolean.notify_path_stale ON (REST-visible
    for the health report); clears them on recovery. Makes a silently dead path visible in < 9 days vs
    the 12 days of inc-2026-07-23-001. Manual test: fire event notify_watchdog_run with data {"force_stale":
    true} to exercise the failure branch. Ref chg-2026-07-24-001.'
  triggers:
  - trigger: time
    at: 09:15:00
    id: sched
  - trigger: event
    event_type: notify_watchdog_run
    id: manual
  variables:
    last_sent: '{{ states(''notify.s25_ultra_sander'') }}'
    age_hours: '{% set s = states(''notify.s25_ultra_sander'') %}{% if s in [''unknown'',''unavailable'','''',''none'']
      %}9999{% else %}{{ ((now() - as_datetime(s)).total_seconds() / 3600) | round(1) }}{% endif %}'
    stale: '{% if trigger is not none and trigger.id == ''manual'' and (trigger.event.data.force_stale
      | default(false)) %}true{% else %}{{ (age_hours | float(9999)) > 192 }}{% endif %}'
  actions:
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ stale }}'
      sequence:
      - action: input_boolean.turn_on
        target:
          entity_id: input_boolean.notify_path_stale
      - action: persistent_notification.create
        data:
          notification_id: notify_path_stale
          title: Critical notify path may be DEAD
          message: 'No notification has reached notify.s25_ultra_sander in {{ ((age_hours | float(9999))
            / 24) | round(1) }} days (last: {{ last_sent }}). The weekly canary should keep this under
            8 days. Likely the mobile_app notify service was renamed again (inc-2026-07-23-001 was a silent
            12-day break). Check ha-cli.sh states notify, then re-fire event notify_canary_run.'
      - action: logbook.log
        data:
          name: Notify path watchdog
          message: STALE - no delivery in {{ ((age_hours | float(9999)) / 24) | round(1) }} days; critical
            notify path may be dead
          entity_id: automation.notify_path_watchdog
    default:
    - action: input_boolean.turn_off
      target:
        entity_id: input_boolean.notify_path_stale
    - action: persistent_notification.dismiss
      data:
        notification_id: notify_path_stale
  mode: single
- id: keuken_adaptief_dag
  alias: Keuken Adaptief (dag)
  description: 'C (chg-2026-07-24-002): 05:30 t/m zonsondergang-1u. Keuken (4 lampen: kastjes/koof/aanrecht/eettafel)
    AAN bij aanwezigheid (FP2 zone-3) + donker (FP2 lux <70, 2min), helderheid geschaald op donkerte,
    warme 120s ramp. AUTO-UIT bij FP2 lux >150 (8min sustained). Latch input_boolean.adaptief_keuken_dag_gedaan:
    her-gewapend bij 05:30 en na auto-uit -> dekt donkere middagen af + ''handmatig uit blijft uit''.
    Overdag eigenaar van de keukenlampen (alleen actief als donker). Avond = 1753005600006, nacht = keuken_nachtlamp.'
  triggers:
  - id: window_start
    trigger: time
    at: 05:30:00
  - id: dark
    trigger: numeric_state
    entity_id: sensor.presence_sensor_fp2_f08e_light_sensor_light_level
    below: 70
    for:
      minutes: 2
  - id: presence
    trigger: state
    entity_id: binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3
    to: 'on'
    from: 'off'
  - id: bright
    trigger: numeric_state
    entity_id: sensor.presence_sensor_fp2_f08e_light_sensor_light_level
    above: 150
    for:
      minutes: 8
  conditions:
  - alias: Na 05:30
    condition: time
    after: 05:30:00
  - alias: Voor zonsondergang-1u
    condition: sun
    before: sunset
    before_offset: -01:00:00
  actions:
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ trigger.id == ''window_start'' }}'
      sequence:
      - action: input_boolean.turn_off
        target:
          entity_id: input_boolean.adaptief_keuken_dag_gedaan
    - conditions:
      - condition: template
        value_template: '{{ trigger.id == ''bright'' }}'
      sequence:
      - action: light.turn_off
        target:
          entity_id:
          - light.ledstrip_keukenkastjes
          - light.lightstrip_koof
          - light.verlichting_aanrecht
          - light.verlichting_eettafel
        data:
          transition: 3
      - action: input_boolean.turn_off
        target:
          entity_id: input_boolean.adaptief_keuken_dag_gedaan
    - conditions:
      - condition: state
        entity_id: input_boolean.adaptief_keuken_dag_gedaan
        state: 'off'
      - condition: numeric_state
        entity_id: sensor.presence_sensor_fp2_f08e_light_sensor_light_level
        below: 70
      - condition: state
        entity_id: binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3
        state: 'on'
      sequence:
      - action: light.turn_on
        target:
          entity_id:
          - light.ledstrip_keukenkastjes
          - light.lightstrip_koof
        data:
          transition: 120
          rgb_color:
          - 255
          - 136
          - 0
          brightness_pct: '{% set L = states(''sensor.presence_sensor_fp2_f08e_light_sensor_light_level'')|float(70)
            %}{% set b = (30 + 40*((70 - L)/70))|round(0) %}{{ [70,[30,b]|max]|min }}'
      - action: light.turn_on
        target:
          entity_id:
          - light.verlichting_aanrecht
          - light.verlichting_eettafel
        data:
          transition: 120
          brightness_pct: '{% set L = states(''sensor.presence_sensor_fp2_f08e_light_sensor_light_level'')|float(70)
            %}{% set b = ((30 + 40*((70 - L)/70))*0.7)|round(0) %}{{ [50,[20,b]|max]|min }}'
      - action: input_boolean.turn_on
        target:
          entity_id: input_boolean.adaptief_keuken_dag_gedaan
  mode: restart
- id: keuken_nachtlamp
  alias: Keuken Nachtlamp
  description: 'D (chg-2026-07-24-002): 23:00 t/m 05:30. Presence-following nachtlampje in de keuken.
    FP2 zone-3 aanwezigheid AAN -> ledstrip_keukenkastjes + lightstrip_koof laag warm. Aanwezigheid weg
    (3 min debounce, FP2 valt kort uit) -> uit. Geen koffie, geen radio. Nacht-uit sweep = 1753005600008;
    presence-exclusief met deze (B alleen bij presence-off, D alleen bij presence-on).'
  triggers:
  - id: aanwezig
    trigger: state
    entity_id: binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3
    to: 'on'
    from: 'off'
  - id: weg
    trigger: state
    entity_id: binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3
    to: 'off'
    from: 'on'
    for:
      minutes: 3
  conditions:
  - alias: Alleen 23:00-05:30
    condition: time
    after: '23:00:00'
    before: 05:30:00
  actions:
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ trigger.id == ''aanwezig'' }}'
      sequence:
      - action: light.turn_on
        target:
          entity_id:
          - light.ledstrip_keukenkastjes
          - light.lightstrip_koof
        data:
          transition: 3
          rgb_color:
          - 255
          - 120
          - 0
          brightness_pct: 12
    - conditions:
      - condition: template
        value_template: '{{ trigger.id == ''weg'' }}'
      sequence:
      - action: light.turn_off
        target:
          entity_id:
          - light.ledstrip_keukenkastjes
          - light.lightstrip_koof
        data:
          transition: 3
  mode: restart
- id: woonkamer_dawn_backstop
  alias: Woonkamer Dawn Backstop
  description: 'E (chg-2026-07-24-002): 05:30 backstop. Sluit het gaatje van B ingekort naar 05:30: als
    iedereen weg is maar B''s 15-min grace de 05:30-grens niet haalt, kunnen door A aangezette WOONKAMER-lampen
    na zonsopkomst blijven branden. Om 05:30, als alle activiteit weg is (zelfde all-clear als B, incl
    woonkamer FP300), gaan de 3 woonkamer-lampen uit. Raakt GEEN keukenstrips (keuken_nachtlamp/C) en
    geen bar. Woonkamer is 05:30..zonsondergang-1u verder niemands eigenaar (handmatig).'
  triggers:
  - id: at_0530
    trigger: time
    at: 05:30:00
  conditions:
  - alias: Alle activiteit weg (incl woonkamer FP300)
    condition: template
    value_template: '{{ is_state(''binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3'',''off'')
      and is_state(''binary_sensor.presence_woonkamer'',''off'') and states(''media_player.tv_woonkamer_2'')
      not in [''on'',''playing''] and states(''media_player.woonkamer'') != ''playing'' and states(''media_player.woonkamer_platenspeler'')
      != ''playing'' and states(''media_player.keuken'') != ''playing'' and states(''media_player.bar_2'')
      != ''playing'' }}'
  - alias: Minstens 1 woonkamer-lamp aan
    condition: template
    value_template: '{{ expand(''light.woonkamer'',''light.woonkamer_lamp'',''light.woonkamer_lamp_2'')
      | selectattr(''state'',''eq'',''on'') | list | count > 0 }}'
  actions:
  - action: light.turn_off
    target:
      entity_id:
      - light.woonkamer
      - light.woonkamer_lamp
      - light.woonkamer_lamp_2
  mode: single
- id: '1756500000001'
  alias: Vloerverwarmingspomp Watchdog
  description: 'Meldt als het pompbeheer is uitgevallen: >48u geen pomprun, of de beheer-automation staat
    uit. Dit is precies de storing die de pomp maandenlang stil liet staan.'
  triggers:
  - trigger: time
    at: '12:00:00'
  conditions: []
  actions:
  - variables:
      age_h: '{{ ((now().timestamp() - state_attr(''input_datetime.vloerpomp_laatste_run'',''timestamp''))
        / 3600) | round(1) }}'
      beheer: '{{ states(''automation.vloerverwarmingspomp_beheer'') }}'
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ (age_h | float(999)) > 48 or beheer != ''on'' }}'
      sequence:
      - action: notify.mobile_app_galaxy_s25_ultra
        data:
          title: 'Vloerverwarmingspomp: geen recente run'
          message: Laatste pomprun {{ age_h }} uur geleden. Beheer-automation staat '{{ beheer }}'. De
            pomp kan vastlopen.
      - action: persistent_notification.create
        data:
          notification_id: vloerpomp_watchdog
          title: Vloerverwarmingspomp
          message: Laatste run {{ age_h }}u geleden; beheer = {{ beheer }}.
  mode: single
- id: woonkamer_avond_uit
  alias: Woonkamer Avond - Uit bij afwezigheid
  description: 'D2 (chg-2026-09-05-001): sluit het gat waar NIEMAND de woonkamer uitzette. A (Adaptieve
    Verlichting Begane Grond) zet ''s avonds aan maar heeft bewust GEEN auto-uit; B (Woonlaag - Nachtelijke
    uit) begint pas om 23:00. Tussen zonsondergang-1u en 23:00 bleef de woonkamer daardoor gemiddeld
    ~104 min per dag leeg-maar-verlicht branden (94% van alle leeg-maar-verlicht). Deze automation raakt
    ALLEEN de 3 woonkamerlampen (light.woonkamer, light.woonkamer_lamp, light.woonkamer_lamp_2) - NOOIT
    de 5 keukenlampen of de 2 barlampen. Twee trappen: 10 min aaneengesloten all-clear -> dim naar 30%;
    20 min -> uit. Komt er iemand terug voordat het uitgaat, dan wordt exact de staat van voor het dimmen
    hersteld (snapshot-scene, fallback = A''s lux-geschaalde helderheid). Na de EIGEN auto-uit blijft de
    run wachten op de woonkamer-FP300: komt er iemand binnen terwijl het donker is, dan gaan dezelfde 3
    lampen weer aan op A''s lux-geschaalde helderheid. A''s latch input_boolean.adaptief_bg_vanavond_gedaan
    wordt NIET aangeraakt (herzien na QA chg-2026-09-05-001): het opnieuw wapenen daarvan liet A opnieuw
    vuren en dus alle 8 begane-grond-lampen inclusief de keuken aangaan, wat de bewust gekozen
    woonkamer-only scope doorbrak. A''s "max 1x per avond" blijft dus intact en A wordt niet gewijzigd.
    All-clear is LETTERLIJK dezelfde template als B: FP2 zone 3 uit EN FP300 woonkamer uit EN TV niet
    on/playing EN geen Sonos playing in woonkamer/platenspeler/keuken/bar - de FP300 meldt aantoonbaar
    11-28 min ten onrechte ''afwezig'' terwijl de TV aanstaat, dus de TV/Sonos-guard is veiligheidskritisch
    en mag NOOIT vereenvoudigd worden. Trigger is uitsluitend AFWEZIGHEID, nooit lux: de lux-gebaseerde
    auto-uit is bewust verwijderd in chg-2026-07-21-005 en komt hier niet terug; lux wordt alleen gebruikt
    om de helderheid te kiezen en om te bepalen of het donker genoeg is om weer aan te doen. "Handmatig
    uit blijft uit" wordt bewaakt door drie identieke guards: voor het dimmen, voor het herstellen en voor
    het uitzetten wordt gecontroleerd of er nog een doellamp brandt; zet de gebruiker de lampen zelf uit,
    dan stopt de run daar en gebeurt er niets meer - geen herstel, geen uit, geen heraansteken. Na 23:00
    stopt deze automation en neemt B het over.'
  triggers:
  - id: all_clear
    trigger: template
    value_template: '{{ is_state(''binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3'',''off'')
      and states(''media_player.tv_woonkamer_2'') not in [''on'',''playing''] and states(''media_player.woonkamer'')
      != ''playing'' and states(''media_player.woonkamer_platenspeler'') != ''playing'' and states(''media_player.keuken'')
      != ''playing'' and states(''media_player.bar_2'') != ''playing'' and is_state(''binary_sensor.presence_woonkamer'',''off'')
      }}'
  - id: window_start
    trigger: sun
    event: sunset
    offset: -01:00:00
  - id: light_on_quiet
    trigger: state
    entity_id:
    - light.woonkamer
    - light.woonkamer_lamp
    - light.woonkamer_lamp_2
    to: 'on'
    for:
      minutes: 1
  conditions:
  - alias: Alleen avond, nooit na 23:00 (dan is B eigenaar)
    condition: time
    after: '12:00:00'
    before: '23:00:00'
  - alias: Na zonsondergang-1u
    condition: sun
    after: sunset
    after_offset: -01:00:00
  - alias: Alle activiteit weg (identieke template als B)
    condition: template
    value_template: '{{ is_state(''binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3'',''off'')
      and states(''media_player.tv_woonkamer_2'') not in [''on'',''playing''] and states(''media_player.woonkamer'')
      != ''playing'' and states(''media_player.woonkamer_platenspeler'') != ''playing'' and states(''media_player.keuken'')
      != ''playing'' and states(''media_player.bar_2'') != ''playing'' and is_state(''binary_sensor.presence_woonkamer'',''off'')
      }}'
  - alias: Minstens 1 woonkamer-lamp aan
    condition: template
    value_template: '{{ expand(''light.woonkamer'',''light.woonkamer_lamp'',''light.woonkamer_lamp_2'')
      | selectattr(''state'',''eq'',''on'') | list | count > 0 }}'
  actions:
  - alias: Fase 1 - 10 min aaneengesloten all-clear afwachten (breekt af zodra iemand terug is)
    wait_template: '{{ not ( is_state(''binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3'',''off'')
      and states(''media_player.tv_woonkamer_2'') not in [''on'',''playing''] and states(''media_player.woonkamer'')
      != ''playing'' and states(''media_player.woonkamer_platenspeler'') != ''playing'' and states(''media_player.keuken'')
      != ''playing'' and states(''media_player.bar_2'') != ''playing'' and is_state(''binary_sensor.presence_woonkamer'',''off'')
      ) }}'
    timeout: '00:10:00'
    continue_on_timeout: true
  - alias: Iemand terug voor het dimmen - er is nog niets veranderd, stoppen
    if:
    - condition: template
      value_template: '{{ wait.completed }}'
    then:
    - stop: Aanwezigheid terug binnen 10 min; niet gedimd, niets uitgezet.
  - alias: Nog binnen het avondvenster (anders neemt B over om 23:00)
    condition: time
    after: '12:00:00'
    before: '23:00:00'
  - alias: GUARD 1/3 - handmatig uit tijdens fase 1? Dan stoppen (handmatig uit blijft uit)
    condition: template
    value_template: '{{ expand(''light.woonkamer'',''light.woonkamer_lamp'',''light.woonkamer_lamp_2'')
      | selectattr(''state'',''eq'',''on'') | list | count > 0 }}'
  - alias: Onthoud welke lampen nu branden
    variables:
      dim_targets: '{{ expand(''light.woonkamer'',''light.woonkamer_lamp'',''light.woonkamer_lamp_2'')
        | selectattr(''state'',''eq'',''on'') | map(attribute=''entity_id'') | list }}'
  - alias: Snapshot van de huidige woonkamerstaat (voor exact herstel)
    action: scene.create
    data:
      scene_id: woonkamer_avond_predim
      snapshot_entities:
      - light.woonkamer
      - light.woonkamer_lamp
      - light.woonkamer_lamp_2
  - alias: Fase 1 - dim de brandende woonkamerlampen naar 30%
    action: light.turn_on
    target:
      entity_id: '{{ dim_targets }}'
    data:
      brightness_pct: 30
      transition: 2
  - alias: Fase 2 - nog 10 min all-clear afwachten (totaal 20)
    wait_template: '{{ not ( is_state(''binary_sensor.presence_sensor_fp2_f08e_presence_sensor_3'',''off'')
      and states(''media_player.tv_woonkamer_2'') not in [''on'',''playing''] and states(''media_player.woonkamer'')
      != ''playing'' and states(''media_player.woonkamer_platenspeler'') != ''playing'' and states(''media_player.keuken'')
      != ''playing'' and states(''media_player.bar_2'') != ''playing'' and is_state(''binary_sensor.presence_woonkamer'',''off'')
      ) }}'
    timeout: '00:10:00'
    continue_on_timeout: true
  - alias: Iemand terug na het dimmen - volledig herstellen en stoppen
    if:
    - condition: template
      value_template: '{{ wait.completed }}'
    then:
    - alias: GUARD 2/3 - tijdens fase 2 handmatig uitgezet? Dan NIET herstellen EN de run stoppen (een
        kale condition in een then-tak stopt de run NIET, die valt door naar de uit-tak - bewezen met
        trace e6b300a0 op 2026-09-05, daarom expliciet stop)
      if:
      - condition: template
        value_template: '{{ expand(dim_targets) | selectattr(''state'',''eq'',''on'') | list | count
          == 0 }}'
      then:
      - stop: Handmatig uitgezet tijdens fase 2; niet herstellen, niets uitzetten, niet heraansteken.
    - choose:
      - alias: Exact herstel via snapshot-scene
        conditions:
        - condition: template
          value_template: '{{ states.scene.woonkamer_avond_predim is not none }}'
        sequence:
        - action: scene.turn_on
          target:
            entity_id: scene.woonkamer_avond_predim
          data:
            transition: 2
      default:
      - alias: Fallback - A''s lux-geschaalde helderheid (nooit hardgecodeerd 100%)
        action: light.turn_on
        target:
          entity_id: '{{ dim_targets }}'
        data:
          transition: 2
          brightness_pct: '{% set fp = states(''sensor.presence_woonkamer_illuminance'')|float(-1) %}{%
            set age = (now() - states.sensor.presence_woonkamer_illuminance.last_updated).total_seconds()
            if has_value(''sensor.presence_woonkamer_illuminance'') else 99999 %}{% set fp2 = states(''sensor.presence_sensor_fp2_f08e_light_sensor_light_level'')|float(-1)
            %}{% set L = fp if (fp >= 0 and age < 3600) else fp2 %}{% set b = (20 + 50*((40 - L)/35))|round(0)
            %}{{ [70,[20,b]|max]|min }}'
    - stop: Aanwezigheid terug; volledige helderheid hersteld, niets uitgezet.
  - alias: Nog binnen het avondvenster (anders neemt B over om 23:00)
    condition: time
    after: '12:00:00'
    before: '23:00:00'
  - alias: GUARD 3/3 - handmatig uit tijdens fase 2? Dan stoppen (handmatig uit blijft uit)
    condition: template
    value_template: '{{ expand(''light.woonkamer'',''light.woonkamer_lamp'',''light.woonkamer_lamp_2'')
      | selectattr(''state'',''eq'',''on'') | list | count > 0 }}'
  - alias: Fase 2 - de 3 woonkamerlampen uit (keuken en bar blijven ongemoeid)
    action: light.turn_off
    target:
      entity_id:
      - light.woonkamer
      - light.woonkamer_lamp
      - light.woonkamer_lamp_2
  - alias: Na EIGEN auto-uit - wachten tot de woonkamer-FP300 weer iemand ziet (max 3u)
    wait_for_trigger:
    - trigger: state
      entity_id: binary_sensor.presence_woonkamer
      to: 'on'
    timeout: '03:00:00'
    continue_on_timeout: true
  - alias: Niemand teruggekomen binnen 3u - klaar
    if:
    - condition: template
      value_template: '{{ wait.trigger is none }}'
    then:
    - stop: Geen terugkeer binnen 3u; lampen blijven uit.
  - alias: Heraansteken mag alleen binnen het avondvenster (na 23:00 is B eigenaar)
    condition: time
    after: '12:00:00'
    before: '23:00:00'
  - alias: Alleen heraansteken als niemand ze zelf al heeft aangedaan
    condition: template
    value_template: '{{ expand(''light.woonkamer'',''light.woonkamer_lamp'',''light.woonkamer_lamp_2'')
      | selectattr(''state'',''eq'',''on'') | list | count == 0 }}'
  - alias: Alleen heraansteken als het donker is (zelfde lux-bron als A, behoudt A''s donker-voorwaarde)
    condition: template
    value_template: '{% set fp = states(''sensor.presence_woonkamer_illuminance'')|float(-1) %}{% set
      age = (now() - states.sensor.presence_woonkamer_illuminance.last_updated).total_seconds() if has_value(''sensor.presence_woonkamer_illuminance'')
      else 99999 %}{% set fp2 = states(''sensor.presence_sensor_fp2_f08e_light_sensor_light_level'')|float(-1)
      %}{% set L = fp if (fp >= 0 and age < 3600) else fp2 %}{{ L >= 0 and L < 40 }}'
  - alias: Heraansteken - dezelfde 3 lampen op A''s lux-geschaalde helderheid (A''s latch blijft ongemoeid)
    action: light.turn_on
    target:
      entity_id: '{{ dim_targets }}'
    data:
      transition: 2
      brightness_pct: '{% set fp = states(''sensor.presence_woonkamer_illuminance'')|float(-1) %}{% set
        age = (now() - states.sensor.presence_woonkamer_illuminance.last_updated).total_seconds() if
        has_value(''sensor.presence_woonkamer_illuminance'') else 99999 %}{% set fp2 = states(''sensor.presence_sensor_fp2_f08e_light_sensor_light_level'')|float(-1)
        %}{% set L = fp if (fp >= 0 and age < 3600) else fp2 %}{% set b = (20 + 50*((40 - L)/35))|round(0)
        %}{{ [70,[20,b]|max]|min }}'
  mode: restart
- id: shelly_relais_onbereikbaar
  alias: 'Shelly: relais onbereikbaar (single-path bewaking)'
  description: 'Bewaakt de 10 Shelly 1PM Mini Gen3 relais (9x Sonos-netvoeding + Verlichting
    Schuur). Sinds chg-2026-09-09-001 zijn alle 10 SINGLE-PATH: alleen sta=VDHIOT, sta1
    uit, eigen AP uit. Een relais dat VDHIOT niet meer kan joinen heeft GEEN fallback en
    GEEN rescue-AP meer en vereist FYSIEKE toegang. Zonder deze bewaking wordt zo''n uitval
    pas opgemerkt als iemand hoort dat een kamer stil is - in chg-2026-09-08-001 duurde dat
    4 dagen. Gekozen signaal is de switch-entiteit (platform shelly) en NIET de device_tracker
    (platform unifi): de switch meet exact wat we willen weten, namelijk of HA de outbound
    websocket naar de Shelly op TCP/80 nog heeft (devices zijn local_push, Ws.enable false),
    terwijl de unifi-tracker alleen AP-associatie meet en dus zowel vals-negatief (wel
    geassocieerd, toch onbereikbaar) als vals-positief (unifi-integratie down = 10 valse
    meldingen) kan zijn. De tracker wordt wel als CONTEXT in het bericht gebruikt om te
    onderscheiden of een fysieke gang naar het apparaat nodig is. Dwell 827 s is gemeten,
    niet gekozen: 1196 goedaardige unavailable-episodes over 8 dagen (02-09 t/m 09-09) gaven
    mediaan 1,5 s, p99 94 s, p99.9 186 s en max 392 s; 827 = 392 x (392/186) en levert 0
    valse meldingen op die dataset (bij 300 s zou het er 1 zijn, bij 120 s negen). Ref
    De namen in het bericht komen uit de LIVE friendly_name (de statische lijst is alleen fallback): de plugstickers klopten niet, switch.sonos_eetkamer en switch.sonos_keuken zijn in werkelijkheid de twee helften van het Keuken-stereopaar, en een hardgecodeerde naam zou iemand naar de verkeerde kamer sturen. Ref chg-2026-09-09-007, inc-2026-09-09-002.'
  mode: single
  max_exceeded: silent
  triggers:
  - trigger: state
    entity_id:
    - switch.sonos_keuken
    - switch.sonos_achtertuin
    - switch.verlichting_schuur
    - switch.sonos_bartafel
    - switch.sonos_surround_rechtsachter
    - switch.sonos_arc_ultra
    - switch.sonos_surround_linksachter
    - switch.sonos_play_1
    - switch.sonos_eetkamer
    - switch.sonos_sub
    to: unavailable
    for: '00:13:47'
    id: dwell
  - trigger: time_pattern
    minutes: '37'
    id: sweep
  - trigger: event
    event_type: shelly_watchdog_test
    id: test
  variables:
    dwell_s: '{{ (trigger.event.data.dwell | default(827)) if (trigger is not none and trigger.id
      == ''test'') else 827 }}'
    shelly_map:
      switch.sonos_keuken: ['Sonos Keuken stereopaar (1 van 2)', '172.16.4.21', 'device_tracker.shelly1pmminig3_34b7da907df0']
      switch.sonos_achtertuin: ['Sonos Achtertuin', '172.16.4.23', 'device_tracker.shelly1pmminig3_34b7da8ff20c']
      switch.verlichting_schuur: ['Verlichting Schuur', '172.16.4.20', 'device_tracker.shelly1pmminig3_34b7da933074']
      switch.sonos_bartafel: ['Sonos Bartafel', '172.16.4.29', 'device_tracker.shelly1pmminig3_34b7da909a14']
      switch.sonos_surround_rechtsachter: ['Sonos Surround Rechtsachter', '172.16.4.22', 'device_tracker.shelly1pmminig3_34b7da8ba988']
      switch.sonos_arc_ultra: ['Sonos Arc Ultra', '172.16.4.26', 'device_tracker.shelly1pmminig3_34b7da921c8c']
      switch.sonos_surround_linksachter: ['Sonos Surround Linksachter', '172.16.4.24', 'device_tracker.shelly1pmminig3_5432045f2cc4']
      switch.sonos_play_1: ['Sonos Play:1', '172.16.4.25', 'device_tracker.shelly1pmminig3_34b7da8fdc60']
      switch.sonos_eetkamer: ['Sonos Keuken stereopaar (2 van 2)', '172.16.4.28', 'device_tracker.shelly1pmminig3_34b7da8bb31c']
      switch.sonos_sub: ['Sonos Sub', '172.16.4.27', 'device_tracker.shelly1pmminig3_34b7da926e64']
    down_n: '{% set d = dwell_s | int(827) %}{% set ns = namespace(n=0) %}{%- for e in shelly_map
      -%}{%- if states(e) == ''unavailable'' and states[e] is not none and (now() - states[e].last_changed).total_seconds()
      > d -%}{%- set ns.n = ns.n + 1 -%}{%- endif -%}{%- endfor -%}{{ ns.n }}'
    down_text: '{% set d = dwell_s | int(827) %}{% set ns = namespace(l=[]) %}{%- for e in
      shelly_map -%}{%- if states(e) == ''unavailable'' and states[e] is not none -%}{%- set
      age = (now() - states[e].last_changed).total_seconds() -%}{%- if age > d -%}{%- set agei
      = age | int -%}{%-
      set w = states(shelly_map[e][2]) -%}{%- set wt = ''wifi NIET verbonden -> fysieke toegang
      nodig'' if w == ''not_home'' else (''wifi verbonden, maar HA krijgt geen verbinding''
      if w == ''home'' else ''wifi onbekend'') -%}{%- set dur = (agei ~ '' s'') if agei < 120
      else (((agei // 60) ~ '' min'') if agei < 7200 else ((agei // 3600) ~ '' uur'')) -%}{%-
      set nm = state_attr(e, ''friendly_name'') or shelly_map[e][0] -%}{%- set ns.l = ns.l + [''- '' ~ nm ~ '' ('' ~ shelly_map[e][1] ~ '') - '' ~
      dur ~ '', '' ~ wt] -%}{%- endif -%}{%- endif -%}{%- endfor -%}{{ ns.l | join(''\n'')
      }}'
  conditions:
  - alias: HA draait zelf langer dan de dwell (na een herstart lijkt een restored:true entiteit
      onbereikbaar - daar mag niet op gemeld worden)
    condition: template
    value_template: '{% set u = states(''sensor.uptime'') | as_datetime %}{{ u is none or (now()
      - u).total_seconds() > 827 }}'
  - alias: Minstens 1 van de 10 Shelly-relais is langer dan de dwell onbereikbaar
    condition: template
    value_template: '{{ (down_n | int(0)) > 0 }}'
  actions:
  - alias: Push naar de telefoon (continue_on_error omdat een hernoemde notify-service de
      hele automation zou afbreken - inc-2026-07-23-001)
    action: notify.mobile_app_galaxy_s25_ultra
    continue_on_error: true
    data:
      title: Shelly relais onbereikbaar ({{ down_n }}/10)
      message: '{{ down_text }}


        Deze relais schakelen Sonos-netvoeding en de schuurverlichting. Ze zijn single-path
        (alleen VDHIOT, geen sta1, geen AP-fallback): staat er ''wifi NIET verbonden'', dan
        is fysieke toegang tot het apparaat nodig.'
      data:
        tag: shelly_unavailable
        channel: Shelly
        importance: high
        priority: high
        ttl: 0
  - alias: Tweede kanaal, onafhankelijk van de mobile_app-integratie
    action: persistent_notification.create
    continue_on_error: true
    data:
      notification_id: shelly_unavailable
      title: Shelly relais onbereikbaar ({{ down_n }}/10)
      message: '{{ down_text }}


        Single-path sinds chg-2026-09-09-001: geen sta1 en geen rescue-AP meer. ''wifi NIET
        verbonden'' = fysieke toegang nodig. Ref chg-2026-09-09-007.'
  - alias: Logboekregel zodat de uitval ook achteraf terug te vinden is
    action: logbook.log
    continue_on_error: true
    data:
      name: Shelly bewaking
      message: '{{ down_n }} van de 10 Shelly-relais langer dan {{ dwell_s }} s onbereikbaar'
  - alias: Fan-in demper. Bij een netwerkstoring vallen alle 10 tegelijk uit; mode single +
      max_exceeded silent + deze delay maken daar 1 melding van in plaats van 10, en zorgen
      daarna voor herhaling ongeveer elke 6 uur zolang de storing duurt (de sweep-trigger pikt
      het weer op).
    delay: '06:00:00'
- id: shelly_relais_hersteld
  alias: 'Shelly: relais weer bereikbaar'
  description: 'Tegenhanger van shelly_relais_onbereikbaar. Meldt herstel zodat niemand voor
    niets naar de schuur of achter een Sonos-speaker loopt, en ruimt de persistent notification
    op zodra alle 10 weer bereikbaar zijn. Meldt alleen als de storing langer duurde dan de
    dwell (827 s), zodat de honderden korte blips - Bartafel alleen al 657 in 8 dagen - nooit
    een melding geven. Ref chg-2026-09-09-007.'
  mode: single
  max_exceeded: silent
  triggers:
  - trigger: state
    entity_id:
    - switch.sonos_keuken
    - switch.sonos_achtertuin
    - switch.verlichting_schuur
    - switch.sonos_bartafel
    - switch.sonos_surround_rechtsachter
    - switch.sonos_arc_ultra
    - switch.sonos_surround_linksachter
    - switch.sonos_play_1
    - switch.sonos_eetkamer
    - switch.sonos_sub
    from: unavailable
    id: hersteld
  conditions:
  - alias: Alleen een echte bruikbare eindtoestand telt als herstel
    condition: template
    value_template: '{{ trigger.to_state is not none and trigger.to_state.state not in [''unavailable'',
      ''unknown'', ''none''] }}'
  - alias: HA draait zelf langer dan de dwell (geen herstelmeldingen door een HA-herstart)
    condition: template
    value_template: '{% set u = states(''sensor.uptime'') | as_datetime %}{{ u is none or (now()
      - u).total_seconds() > 827 }}'
  - alias: De storing duurde langer dan de dwell, dus er is ook een alarm voor verstuurd
    condition: template
    value_template: '{{ (as_timestamp(trigger.to_state.last_changed) - as_timestamp(trigger.from_state.last_changed))
      > 827 }}'
  variables:
    still_down: '{% set ns = namespace(n=0) %}{%- for e in [''switch.sonos_keuken'', ''switch.sonos_achtertuin'',
      ''switch.verlichting_schuur'', ''switch.sonos_bartafel'', ''switch.sonos_surround_rechtsachter'',
      ''switch.sonos_arc_ultra'', ''switch.sonos_surround_linksachter'', ''switch.sonos_play_1'',
      ''switch.sonos_eetkamer'', ''switch.sonos_sub''] -%}{%- if states(e) == ''unavailable''
      -%}{%- set ns.n = ns.n + 1 -%}{%- endif -%}{%- endfor -%}{{ ns.n }}'
  actions:
  - action: notify.mobile_app_galaxy_s25_ultra
    continue_on_error: true
    data:
      title: Shelly relais weer bereikbaar
      message: '{{ trigger.to_state.attributes.friendly_name }} is weer bereikbaar na {{ (((as_timestamp(trigger.to_state.last_changed)
        - as_timestamp(trigger.from_state.last_changed)) / 60) | round(0)) | int }} min. Nog
        {{ still_down }} van de 10 onbereikbaar.'
      data:
        tag: shelly_unavailable
        channel: Shelly
        priority: high
        ttl: 0
  - choose:
    - alias: Alles weer op - meldingsballon opruimen
      conditions:
      - condition: template
        value_template: '{{ (still_down | int(99)) == 0 }}'
      sequence:
      - action: persistent_notification.dismiss
        continue_on_error: true
        data:
          notification_id: shelly_unavailable
  - alias: Bij massaherstel niet 10 losse meldingen sturen
    delay: '00:03:00'
- id: '1789640000001'
  alias: Vlucht HV5022 - Femke thuisvlucht (tijdelijk)
  description: >-
    TIJDELIJK - bedoeld om na 2026-09-17 verwijderd te worden (chg-2026-09-17-003).
    Bewaakt Transavia HV5022 (AGP -> RTM, toestel PH-HZO, FR24 id 41b3c3e8) en
    pusht naar notify.mobile_app_galaxy_s25_ultra precies drie dingen: (1) vertrek
    uit Malaga zodra de eerste echte ETA bekend is, (2) elke ETA-wijziging van 15
    minuten of meer ten opzichte van de LAATST GEPUSHTE ETA - dus niet ten opzichte
    van de vorige poll, anders komt er een stroom van minuut-drift, (3) de landing.
    Daarna verwijdert hij de vlucht uit FlightRadar24 en zet hij zichzelf uit, zodat
    er geen dode config achterblijft. Vangnet tegen stilte: als de vlucht uit de
    tracking verdwijnt (annulering) of als het om 15:30 nog steeds stil is, gaat er
    een waarschuwing uit in plaats van niets. De landingsmelding komt alleen van
    hard bewijs (FR24 landing-event of een ingevulde time_real_arrival) en noemt de
    werkelijke bestemming, zodat een uitwijk niet als thuiskomst wordt gemeld.
    LET OP - flightradar24 v2.2.0 registreert GEEN services. Toevoegen en verwijderen
    van een gevolgde vlucht gaat via text.set_value op text.flightradar24_add_to_track
    respectievelijk text.flightradar24_remove_from_track.
  mode: single
  max_exceeded: silent
  triggers:
  - trigger: homeassistant
    event: start
    id: arm
  - trigger: event
    event_type: vlucht_hv5022_arm
    id: arm
  conditions: []
  actions:
  - repeat:
      count: 40
      sequence:
      - variables:
          eta_ref: >-
            {% set fl = state_attr('sensor.flightradar24_additional_tracked','flights') or [] %}
            {% set f = (fl | selectattr('flight_number','eq','HV5022') | list | first) | default(none) %}
            {{ (f.time_estimated_arrival | default(0) | int(0)) if f else 0 }}
      - wait_for_trigger:
        - trigger: template
          id: eta
          value_template: >-
            {% set fl = state_attr('sensor.flightradar24_additional_tracked','flights') or [] %}
            {% set f = (fl | selectattr('flight_number','eq','HV5022') | list | first) | default(none) %}
            {% set eta = (f.time_estimated_arrival | default(0) | int(0)) if f else 0 %}
            {{ eta > 0 and ((eta_ref | int(0)) == 0 or ((eta - (eta_ref | int(0))) | abs) >= 900) }}
        - trigger: event
          event_type: flightradar24_tracked_landed
          id: geland
        - trigger: template
          id: geland
          value_template: >-
            {% set fl = state_attr('sensor.flightradar24_additional_tracked','flights') or [] %}
            {% set f = (fl | selectattr('flight_number','eq','HV5022') | list | first) | default(none) %}
            {{ f is not none and (f.time_real_arrival | default(0) | int(0)) > 0 }}
        - trigger: template
          id: weg
          value_template: >-
            {% set fl = state_attr('sensor.flightradar24_additional_tracked','flights') or [] %}
            {{ (fl | selectattr('flight_number','eq','HV5022') | list | count) == 0 }}
        - trigger: time
          at: '15:30:00'
          id: deadline
        timeout: '06:00:00'
        continue_on_timeout: true
      - variables:
          fl_eta: >-
            {% set fl = state_attr('sensor.flightradar24_additional_tracked','flights') or [] %}
            {% set f = (fl | selectattr('flight_number','eq','HV5022') | list | first) | default(none) %}
            {{ (f.time_estimated_arrival | default(0) | int(0)) if f else 0 }}
          fl_sta: >-
            {% set fl = state_attr('sensor.flightradar24_additional_tracked','flights') or [] %}
            {% set f = (fl | selectattr('flight_number','eq','HV5022') | list | first) | default(none) %}
            {{ (f.time_scheduled_arrival | default(0) | int(0)) if f else 0 }}
          fl_rdep: >-
            {% set fl = state_attr('sensor.flightradar24_additional_tracked','flights') or [] %}
            {% set f = (fl | selectattr('flight_number','eq','HV5022') | list | first) | default(none) %}
            {{ (f.time_real_departure | default(0) | int(0)) if f else 0 }}
          fl_rarr: >-
            {% set fl = state_attr('sensor.flightradar24_additional_tracked','flights') or [] %}
            {% set f = (fl | selectattr('flight_number','eq','HV5022') | list | first) | default(none) %}
            {{ (f.time_real_arrival | default(0) | int(0)) if f else 0 }}
          fl_dest: >-
            {% set fl = state_attr('sensor.flightradar24_additional_tracked','flights') or [] %}
            {% set f = (fl | selectattr('flight_number','eq','HV5022') | list | first) | default(none) %}
            {{ (f.airport_destination_code_iata | default('', true)) if f else '' }}
      - choose:
        - conditions:
          - condition: template
            value_template: "{{ wait.trigger is not none and wait.trigger.id == 'geland' }}"
          sequence:
          - action: notify.mobile_app_galaxy_s25_ultra
            data:
              title: Vlucht HV5022
              message: >-
                {% if fl_dest and fl_dest != 'RTM' %}LET OP - HV5022 is GELAND op
                {{ fl_dest }}, NIET op Rotterdam. De vlucht is uitgeweken; rij nog
                niet naar RTM zonder dit te controleren.{% else %}HV5022 is GELAND op
                Rotterdam{% if fl_rarr > 0 %} om {{ fl_rarr | timestamp_custom('%H:%M', true) }}{% endif %}.
                Femke is binnen - reken op uitstappen, bagage en douane.{% endif %}
          - action: text.set_value
            target:
              entity_id: text.flightradar24_remove_from_track
            data:
              value: HV5022
          - action: automation.turn_off
            data:
              entity_id: '{{ this.entity_id }}'
              stop_actions: false
          - stop: HV5022 geland - tracking verwijderd en automation uitgezet
        - conditions:
          - condition: template
            value_template: "{{ wait.trigger is not none and wait.trigger.id == 'eta' }}"
          sequence:
          - action: notify.mobile_app_galaxy_s25_ultra
            data:
              title: Vlucht HV5022
              message: >-
                {% set ref = eta_ref | int(0) %}
                {% set voor = fl_sta - fl_eta %}
                {% if ref == 0 %}{% if fl_rdep > 0 %}HV5022 is vertrokken uit Malaga om
                {{ fl_rdep | timestamp_custom('%H:%M', true) }}.{% else %}HV5022 is onderweg.{% endif %}
                Verwachte landing Rotterdam {{ fl_eta | timestamp_custom('%H:%M', true) }}{% if voor >= 60 %},
                dat is {{ (voor / 60) | round(0) }} min VOOR het schema van
                {{ fl_sta | timestamp_custom('%H:%M', true) }}{% elif voor <= -60 %}, dat is
                {{ ((0 - voor) / 60) | round(0) }} min NA het schema van
                {{ fl_sta | timestamp_custom('%H:%M', true) }}{% else %} (gelijk aan het schema){% endif %}.
                Deze rotatie landt vaak vroeger dan gepland - reken op de verwachte tijd,
                niet op 14:25.{% else %}ETA Rotterdam gewijzigd: {{ ref | timestamp_custom('%H:%M', true) }}
                wordt {{ fl_eta | timestamp_custom('%H:%M', true) }}
                ({{ '+' if fl_eta > ref else '-' }}{{ (((fl_eta - ref) | abs) / 60) | round(0) }} min).
                Schema is {{ fl_sta | timestamp_custom('%H:%M', true) }}.{% endif %}
        - conditions:
          - condition: template
            value_template: "{{ wait.trigger is not none and wait.trigger.id == 'weg' }}"
          sequence:
          - action: notify.mobile_app_galaxy_s25_ultra
            data:
              title: Vlucht HV5022
              message: >-
                HV5022 is uit de FlightRadar24-tracking verdwenen zonder landingsmelding.
                Dat kan annulering, uitwijk of een storing bij FR24 zijn. Er komt geen
                automatische melding meer - controleer de vlucht zelf voordat je naar
                Rotterdam rijdt.
          - action: automation.turn_off
            data:
              entity_id: '{{ this.entity_id }}'
              stop_actions: false
          - stop: HV5022 niet meer te volgen - gebruiker gewaarschuwd
        - conditions:
          - condition: template
            value_template: "{{ wait.trigger is not none and wait.trigger.id == 'deadline' }}"
          sequence:
          - action: notify.mobile_app_galaxy_s25_ultra
            data:
              title: Vlucht HV5022
              message: >-
                Het is 15:30 en er is nog geen landing van HV5022 gemeld, terwijl de
                geplande aankomst 14:25 was. De bewaking loopt nog door, maar controleer
                de vlucht zelf - dit kan op vertraging, uitwijk of een storing wijzen.
        default:
        - action: notify.mobile_app_galaxy_s25_ultra
          data:
            title: Vlucht HV5022
            message: >-
              De bewaking van HV5022 is gestopt zonder landingsmelding (time-out na 6 uur).
              Er komt geen automatische melding meer - controleer de vlucht zelf.
        - action: automation.turn_off
          data:
            entity_id: '{{ this.entity_id }}'
            stop_actions: false
        - stop: HV5022 bewaking getimed out
