<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sheijden.workqueue-tick</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-I</string>
        <string>/Users/sheijden/.local/bin/workqueue.py</string>
        <string>tick</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/sheijden</string>
        <key>WORKQUEUE</key>
        <string>/Users/sheijden/.local/state/workqueue/workqueue.jsonl</string>
    </dict>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/sheijden/Library/Logs/workqueue-tick.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sheijden/Library/Logs/workqueue-tick.log</string>
</dict>
</plist>
