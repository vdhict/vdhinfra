<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- chg-2026-10-24-003: one Larry handoff line per critical Mac host alert per day.
     Install on the Mini: cp to ~/Library/LaunchAgents/, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.vdhict.host-alert-handoff.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>net.vdhict.host-alert-handoff</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>/Users/sheijden/Code/homelab-migration/vdhinfra/hack/ops/host-alert-handoff.sh</string></array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/sheijden/Library/Logs/host-alert-handoff.log</string>
  <key>StandardErrorPath</key><string>/Users/sheijden/Library/Logs/host-alert-handoff.log</string>
</dict>
</plist>
