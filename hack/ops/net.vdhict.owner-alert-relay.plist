<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- wq-161: owner money/act-on alerts from Alertmanager to pka-alert --for-sander, day only (hack/ops/owner-alert-relay.sh).
     Runs the PINNED copy in ~/.local/libexec, never the working tree (Argus C2). Do not install by hand:
       hack/ops/owner-alert-relay-install.sh          (dry: shows what it would do)
       hack/ops/owner-alert-relay-install.sh --live    (copy from origin/main, record sha256, bootstrap)
       hack/ops/owner-alert-relay-install.sh --check   (running copy vs recorded sha vs origin/main)
     Deliberately NO EnvironmentVariables: OWNER_RELAY_TEST must stay unset here (Argus C3). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>net.vdhict.owner-alert-relay</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>/Users/sheijden/.local/libexec/owner-alert-relay.sh</string></array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/sheijden/Library/Logs/owner-alert-relay.log</string>
  <key>StandardErrorPath</key><string>/Users/sheijden/Library/Logs/owner-alert-relay.log</string>
</dict>
</plist>
