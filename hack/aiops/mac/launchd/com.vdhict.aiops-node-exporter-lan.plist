<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- chg-2026-10-12-009: launchd owns __LAN_IP__:9100 and hands each
     connection to Apple-signed /usr/bin/nc -> 127.0.0.1:9100. launchd is
     allowed by the macOS application firewall, so no firewall exception and
     no sudo are needed; the ad-hoc-signed Homebrew binary never listens on
     the LAN. Same pattern as com.sheijden.k8s-proxy. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.vdhict.aiops-node-exporter-lan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/nc</string>
    <string>127.0.0.1</string>
    <string>9100</string>
  </array>
  <key>Sockets</key>
  <dict>
    <key>Listener</key>
    <dict>
      <key>SockNodeName</key><string>__LAN_IP__</string>
      <key>SockServiceName</key><string>9100</string>
      <key>SockType</key><string>stream</string>
    </dict>
  </dict>
  <key>inetdCompatibility</key>
  <dict><key>Wait</key><false/></dict>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/aiops-node-exporter-lan.log</string>
</dict>
</plist>
