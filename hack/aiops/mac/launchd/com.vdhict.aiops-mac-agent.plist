<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- chg-2026-10-12-009: LAN cluster check (no ntfy heartbeat since 2026-10-13) + crash textfile, every 5 min. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.vdhict.aiops-mac-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/bin/aiops-mac-agent</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/aiops-mac-agent.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/aiops-mac-agent.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>__HOME__</string>
  </dict>
</dict>
</plist>
