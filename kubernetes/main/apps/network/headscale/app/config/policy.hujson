// chg-2026-11-02-012 stage 2, Argus-reviewed (verdict 2026-11-03, B1/B2). Deny by default: only the grants below pass.
// NEVER drop the "grants" key: Headscale treats a policy without acls/grants as ALLOW-ALL.
// No autoApprovers, no exit nodes, no ssh rules (OpenSSH over the tailnet IP only).
// B1: tagOwners are empty lists. Tags come only from pre-auth keys created in-pod with --tags (no self-tagging).
// B3: vdhnblin01 is node id 1 at 100.64.0.1. Losing that device: remove the hosts entry first, then `nodes delete -i 1`.
// chg-2026-11-20-060 (tsk-2026-11-20-118): family chat over the tailnet.
//   - group:gezin may reach ONLY gezin-chat (172.16.2.253, Gateway envoy-gezin: chat + auth hostnames) on tcp:443.
//   - Members are Headscale usernames. Family accounts use NEUTRAL usernames (gezin2..gezin4) so no personal name is
//     ever in this public file; who is who is known to the owner only. Do not add display names to Git.
//   - The one subnet route is 172.16.2.253/32, advertised by tag:gezinrouter (in-cluster, userspace) and approved by
//     hand (`headscale nodes approve-routes`), never by autoApprovers. tag:gezinrouter is never a source.
//   - The two pre-existing grants below are unchanged, byte for byte.
{
  "groups": {
    "group:gezin": ["sander@", "gezin2@", "gezin3@", "gezin4@"]
  },
  "tagOwners": {
    "tag:agenthost": [],   // vdhmini01: shared uid with myPKA, destination only, never a source
    "tag:rekenkracht": [], // vdhllmsrv01 (Studio), vdhwslin01
    "tag:canary": [],      // in-cluster test node (B2: Mini ssh only)
    "tag:gezinrouter": []  // in-cluster subnet router for 172.16.2.253/32 only (chg-2026-11-20-060)
  },
  "hosts": {
    "vdhnblin01": "100.64.0.1/32",
    "gezin-chat": "172.16.2.253/32"
  },
  "grants": [
    { "src": ["vdhnblin01"], "dst": ["tag:agenthost", "tag:rekenkracht"], "ip": ["tcp:22"] },
    { "src": ["tag:canary"], "dst": ["tag:agenthost"], "ip": ["tcp:22"] },
    { "src": ["group:gezin"], "dst": ["gezin-chat"], "ip": ["tcp:443"] }
  ],
  "ssh": []
}
