#!/usr/bin/env python3
"""G8 monthly digest line for family-cloud (chg-2026-11-17-011, Argus G8, tsk-2026-11-20-124): the ledger usd of the
closed month plus the number of off/on transitions, so the owner can compare it with his console usage.

The ledger (month.json) holds ONE month and resets itself on the first routed call of a new month, so the closed month's
amount must be saved before that. Two modes, both stdlib only, both reading the ledger directory READ-ONLY:

  cloud-digest snapshot --ledger-dir /cloud-spend --state-dir DIR     run often (e.g. every 15 min): keeps the highest
                                                                      usd seen per month in DIR/cloud-digest-history.json
  cloud-digest digest   --ledger-dir /cloud-spend --state-dir DIR [--month YYYY-MM] [--now ISO]
                                                                      prints ONE JSON line {"line": "...", ...}; default
                                                                      month = the previous UTC month; it snapshots first.

The line never carries a person or profile name (S-F5): totals only. Exit codes: 0 digest produced and complete,
3 produced but incomplete (no snapshot of that month, or the newest one is older than --max-age-hours before month end),
4 ledger or history unreadable. The digest does not send anything; Atlas's job posts the line (team topic) and the
change-log line. Cost: none, no network.
"""
import argparse
import contextlib
import datetime as dt
import fcntl
import json
import math
import os
import re
import secrets
import sys
from pathlib import Path

HISTORY = 'cloud-digest-history.json'
MONTH_RE = re.compile(r'[0-9]{4}-(0[1-9]|1[0-2])')


def utc(ts):
    return dt.datetime.fromtimestamp(ts, dt.timezone.utc)


def prev_month(now):
    first = now.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
    return (first - dt.timedelta(days=1)).strftime('%Y-%m')


def month_end(month):
    y, m = int(month[:4]), int(month[5:])
    return dt.datetime(y + (m == 12), 1 if m == 12 else m + 1, 1, tzinfo=dt.timezone.utc)


def read_ledger(ledger_dir):
    data = json.loads((Path(ledger_dir) / 'month.json').read_text())
    usd = data['usd']
    if (type(usd) not in (int, float) or not math.isfinite(usd) or usd < 0 or not isinstance(data['month'], str)
            or not MONTH_RE.fullmatch(data['month'])):
        raise ValueError('ledger')
    return {'month': data['month'], 'usd': float(usd), 'input_tokens': int(data.get('input_tokens', 0)),
            'output_tokens': int(data.get('output_tokens', 0))}


def load_history(state_dir):
    path = Path(state_dir) / HISTORY
    if not path.exists():
        return {}
    data = json.loads(path.read_text())
    if not isinstance(data, dict):
        raise ValueError('history')
    return data


@contextlib.contextmanager
def state_lock(state_dir):
    """Exclusive lock from reading the history to the replace, so two runs never lose or tear it (Argus C2)."""
    Path(state_dir).mkdir(parents=True, exist_ok=True)
    fd = os.open(Path(state_dir) / (HISTORY + '.lock'), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)   # closing releases the lock


def save_history(state_dir, history):
    Path(state_dir).mkdir(parents=True, exist_ok=True)
    path = Path(state_dir) / HISTORY
    temp = Path('%s.%d.%s.new' % (path, os.getpid(), secrets.token_hex(8)))   # unique name, never reused
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, 'w') as f:
            json.dump(history, f, sort_keys=True)
            f.flush()
            os.fsync(f.fileno())
        temp.replace(path)
    except BaseException:
        temp.unlink(missing_ok=True)
        raise


def snapshot(ledger_dir, state_dir, now):
    ledger = read_ledger(ledger_dir)
    history = load_history(state_dir)
    old = history.get(ledger['month'])
    if old is None or ledger['usd'] >= old['usd']:   # a month's usd only grows; never overwrite with less
        history[ledger['month']] = dict(usd=ledger['usd'], input_tokens=ledger['input_tokens'],
                                        output_tokens=ledger['output_tokens'], seen=now.strftime('%Y-%m-%dT%H:%M:%SZ'))
        save_history(state_dir, history)
    return ledger['month'], history


def transitions(ledger_dir, month):
    off = on = same_month_200 = 0
    path = Path(ledger_dir) / 'cloud-transitions.jsonl'
    if path.exists():
        for raw in path.read_text().splitlines():
            try:
                line = json.loads(raw)
                ts, to = float(line['ts']), line['to']
                if not math.isfinite(ts) or not 0 <= ts <= 4102444800:   # 1970 .. 2100
                    continue
                stamp = utc(ts).strftime('%Y-%m')
            except Exception:
                continue   # a broken line is skipped, never counted
            if stamp != month:
                continue
            if line.get('kind') == 'same_month_200':
                same_month_200 += 1
            elif to == 'off':
                off += 1
            elif to == 'on':
                on += 1
    return off, on, same_month_200


def digest(ledger_dir, state_dir, month, now, max_age_hours):
    snapshot(ledger_dir, state_dir, now)
    history = load_history(state_dir)
    off, on, smc = transitions(ledger_dir, month)
    entry = history.get(month)
    complete = entry is not None
    note = ''
    if complete:
        seen = dt.datetime.strptime(entry['seen'], '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=dt.timezone.utc)
        if month_end(month) > now:
            complete, note = False, 'month not closed yet'
        elif month_end(month) - seen > dt.timedelta(hours=max_age_hours):
            complete = False
            note = 'last ledger snapshot %s is more than %sh before month end: usd may be too low' % (entry['seen'], max_age_hours)
    else:
        note = 'no ledger snapshot for this month: usd unknown'
    usd = ('USD %.2f' % entry['usd']) if entry else 'USD unknown'
    text = ('family-cloud month %s: ledger-peak %s, off %d, on %d, same-month-200 %d%s. Compare with the console usage '
            'for the same month.' % (month, usd, off, on, smc, (' (' + note + ')') if note else ''))
    return complete, dict(line=text, month=month, usd=entry['usd'] if entry else None, off=off, on=on,
                          same_month_200=smc, complete=complete, note=note)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    ap.add_argument('mode', choices=['snapshot', 'digest'])
    ap.add_argument('--ledger-dir', required=True)
    ap.add_argument('--state-dir', required=True)
    ap.add_argument('--month')
    ap.add_argument('--now', help='ISO UTC time, for tests and drills')
    ap.add_argument('--max-age-hours', type=float, default=26)
    args = ap.parse_args(argv)
    now = dt.datetime.fromisoformat(args.now.replace('Z', '+00:00')).astimezone(dt.timezone.utc) if args.now \
        else dt.datetime.now(dt.timezone.utc)
    if args.month and not MONTH_RE.fullmatch(args.month):
        print(json.dumps(dict(result='error', note='bad --month')))
        return 4
    try:
        with state_lock(args.state_dir):
            if args.mode == 'snapshot':
                month, _ = snapshot(args.ledger_dir, args.state_dir, now)
                print(json.dumps(dict(result='snapshot', month=month)))
                return 0
            complete, out = digest(args.ledger_dir, args.state_dir, args.month or prev_month(now), now, args.max_age_hours)
    except Exception as exc:
        print(json.dumps(dict(result='ledger_unreadable', error=type(exc).__name__)))
        return 4
    print(json.dumps(out))
    return 0 if complete else 3


if __name__ == '__main__':
    sys.exit(main())
